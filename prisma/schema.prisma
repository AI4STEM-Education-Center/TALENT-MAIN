generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Users ────────────────────────────────────────────────────────────────────
// role: "TEACHER" | "STUDENT"

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  username       String   @unique
  hashedPassword String
  firstName      String
  lastName       String
  role           String   @default("STUDENT")
  createdAt      DateTime @default(now())

  teacher Teacher?
  student Student?

  sentMessages        Message[]            @relation("MessageSender")
  notifications       Notification[]       @relation("UserNotifications")
  passwordResetTokens PasswordResetToken[]
  poolSubmissionReviews PoolSubmission[] @relation("PoolSubmissionReviewer")
  consentRecords        ConsentRecord[]
  consentExportReviews  ConsentExportRequest[] @relation("ConsentExportReviewer")

  @@index([role])
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per-teacher email sending caps (recipient-emails). null = use the global
  // default (see DEFAULT_EMAIL_DAILY_LIMIT / DEFAULT_EMAIL_MONTHLY_LIMIT in
  // src/lib/email-limits.ts). Admins override these per teacher.
  emailDailyLimit   Int?
  emailMonthlyLimit Int?

  classes           Class[]
  topics            Topic[]             @relation("TeacherTopics")
  quizzes           Quiz[]              @relation("TeacherQuizzes")
  questions         Question[]          @relation("TeacherQuestions")
  questionImports   QuestionImport[]
  learningMaterials LearningMaterial[]
  pdfExtractions    QuizPdfExtraction[]
  poolSubmissions   PoolSubmission[]
  consentExportRequests ConsentExportRequest[]
}

// Uploaded learning materials (S3 only). uploadStatus: "PENDING" | "READY" | "FAILED"
model LearningMaterial {
  id           String  @id @default(cuid())
  // NULL means this row is an administrator-managed global-pool snapshot.
  teacherId    String?
  classId      String?
  topicId      String?
  sourceMaterialId String?
  title        String?
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  bucket       String
  uploadStatus String  @default("PENDING")
  processingStatus String @default("IDLE")
  folder       String?
  totalPages     Int     @default(0)
  processedPages Int     @default(0)
  errorMessage   String?
  batchDescription  String?
  batchKeyConcepts  String  @default("[]")

  // AI generation metrics from the most recent VLM processing run. Shown to
  // teachers/admins; null until the material is processed.
  aiModel  String?
  aiProvider String? // "openai" | "local" | "cloudflare"; null on runs from before it was recorded
  aiServiceTier String? // "flex" | "auto" | "default"; null when the model has no tier set
  aiThinkingLevel String? // reasoning effort the run was made with; null when the model has none pinned
  aiTtftMs Int? // time to first token (ms)
  aiTokens Int? // generated tokens summed across all page + batch calls
  aiTotalMs Int? // total wall-clock time summed across all page + batch calls (ms)

  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  pages   MaterialPage[]
  classLinks MaterialClass[]
  poolSubmissions PoolSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([classId])
  @@index([topicId])
  @@index([sourceMaterialId])
}

// Junction: a material can be shared across multiple of a teacher's classes.
model MaterialClass {
  id         String   @id @default(cuid())
  materialId String
  classId    String
  createdAt  DateTime @default(now())

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  class    Class            @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([materialId, classId])
  @@index([classId])
  @@index([materialId])
}

model MaterialPage {
  id           String  @id @default(cuid())
  materialId   String
  pageNumber   Int
  storageKey   String

  // Tier 1 VLM results (null = not yet processed)
  needed       Boolean?
  keyConcept   String?
  description  String?

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([materialId, pageNumber])
  @@index([materialId])
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enrollments  ClassEnrollment[]
  quizProgress QuizProgress[]
  quizAttempts QuizAttempt[]
}

// ─── Classes ──────────────────────────────────────────────────────────────────

model Class {
  id          String   @id @default(cuid())
  name        String
  description String?
  teacherId   String
  createdAt   DateTime @default(now())

  teacher        Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments    ClassEnrollment[]
  invitations    Invitation[]
  classQuizzes   ClassQuiz[]
  quizProgress   QuizProgress[]
  quizAttempts   QuizAttempt[]
  studentList    ClassStudentList[]
  learningMaterials LearningMaterial[]
  materialLinks  MaterialClass[]
  messages       Message[]
  consentExportRequests ConsentExportRequest[]
}

model ClassStudentList {
  id           String   @id @default(cuid())
  classId      String
  orgDefinedId String   // stored WITHOUT "#" prefix, e.g. "811947904"
  firstName    String
  lastName     String
  email        String   @default("") // student email — required for teacher→student notifications (default "" keeps db push safe on existing rows)
  isRegistered Boolean  @default(false)
  createdAt    DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, orgDefinedId])
  @@index([orgDefinedId])
}

model ClassEnrollment {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  joinedAt  DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  // Student "my classes" list: WHERE studentId ORDER BY joinedAt DESC
  @@index([studentId, joinedAt])
}

model Invitation {
  id        String    @id @default(cuid())
  classId   String
  // No @default(cuid()): this token is a BEARER CREDENTIAL for joining a class
  // (and for the roster lookup that discloses student names/emails), so it must
  // be unguessable. cuid v1 is timestamp-prefixed with Math.random-derived
  // blocks — fine for row ids, not for secrets. The API generates it with
  // crypto.randomBytes; see src/app/api/invitations/route.ts.
  token     String    @unique
  expiresAt DateTime?
  maxUses   Int?
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

// One admin-issued teacher registration code. Teachers self-register at
// /register by presenting a code; each code carries its own expiry and use
// limit so an administrator can hand out a single-use, week-long code for one
// hire and an open code for a workshop, and revoke either independently.
//
// Deliberately RELATION-FREE (createdById carries no FK, like
// ConsentExportSettings.updatedById): deleting the admin who issued a code must
// not delete the code, and the audit trail of who issued it should survive.
//
// The code is stored in plaintext rather than hashed, unlike
// PasswordResetToken: an admin has to be able to re-read a code in the panel to
// share it again, and the same trade-off is already made for Invitation.token.
// It is still a BEARER CREDENTIAL — anyone holding it can create a TEACHER
// account — so it is generated with crypto.randomBytes, never a cuid()
// default; see src/lib/teacher-registration-codes.ts.
model TeacherRegistrationCode {
  id    String  @id @default(cuid())
  code  String  @unique
  /// Admin-facing note ("Fall 2026 TAs"), so a code list is readable.
  label String?

  /// null = never expires.
  expiresAt DateTime?
  /// null = unlimited registrations.
  maxUses   Int?
  usedCount Int       @default(0)
  /// Revoked codes stay in the table as an audit record; this is the kill switch.
  active    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  createdById String?
  lastUsedAt  DateTime?

  // Admin list: newest-first.
  @@index([createdAt])
}

// ─── Content ──────────────────────────────────────────────────────────────────
// Ownership convention: teacherId = NULL means the row lives in the GLOBAL POOL
// (admin-managed); a non-null teacherId means it is private to that teacher.
// Promote (admin) and import (teacher) both deep-copy, so pool and teacher
// content never affect each other.
// Physical table/column names are pinned with @map — deploys apply the schema
// with `prisma db push`, and a real rename would drop the data.

model Topic {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  // QUIZ and MATERIAL labels live in separate namespaces, even when they
  // have the same owner (including the administrator-managed global pools).
  contentType String  @default("QUIZ")
  teacherId String?  @map("createdById")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher? @relation("TeacherTopics", fields: [teacherId], references: [id], onDelete: Cascade)
  quizzes Quiz[]
  learningMaterials LearningMaterial[]
  poolSubmissions PoolSubmission[]

  @@index([teacherId])
  @@index([teacherId, contentType])
}

// A quiz (formerly "Subtopic" / "Module") is the unit students take: a named,
// owned set of questions. topicId is an optional grouping label only —
// deleting a topic detaches its quizzes, never deletes them.
model Quiz {
  id           String   @id @default(cuid())
  name         String
  order        Int      @default(0)
  topicId      String?
  teacherId    String?  @map("createdById")
  sourceQuizId String? // lineage: the pool quiz this was imported from, or the teacher quiz a pool copy was promoted from
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  topic          Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  teacher        Teacher?            @relation("TeacherQuizzes", fields: [teacherId], references: [id], onDelete: Cascade)
  questions      Question[]
  quizProgress   QuizProgress[]
  quizAttempts   QuizAttempt[]
  imports        QuestionImport[]
  classQuizzes   ClassQuiz[]
  pdfExtractions QuizPdfExtraction[]
  poolSubmissions PoolSubmission[]

  @@index([topicId])
  @@index([teacherId])
  @@map("Subtopic")
}

// Teacher-submitted requests to add a quiz or material snapshot to the global
// pool. contentType: "QUIZ" | "MATERIAL". status: "PENDING" | "REVIEWING" |
// "APPROVED" | "REJECTED". The chosen reviewer is always an ADMIN User.
model PoolSubmission {
  id           String   @id @default(cuid())
  contentType  String
  status       String   @default("PENDING")
  teacherId    String
  reviewerId   String
  quizId       String?
  materialId   String?
  topicId      String?
  decisionNote String?
  emailStatus  String   @default("PENDING")
  emailError   String?
  decidedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher  Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  reviewer User              @relation("PoolSubmissionReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  quiz     Quiz?             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  material LearningMaterial? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  topic    Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([teacherId, status])
  @@index([reviewerId, status])
  @@index([quizId])
  @@index([materialId])
}

// difficultyLevel: "BEGINNER" | "INTERMEDIATE" | "ADVANCED"
// answerMode: "SINGLE_SELECT" | "MULTI_SELECT" | "NUMERIC"
// True/false questions are SINGLE_SELECT with two options ("True"/"False").
model Question {
  id                String   @id @default(cuid())
  title             String?
  text              String
  quizId            String   @map("subtopicId")
  difficultyLevel   String   @default("BEGINNER")
  answerMode        String   @default("SINGLE_SELECT")
  points            Int?
  feedbackGeneral   String?
  feedbackCorrect   String?
  feedbackIncorrect String?
  sourceQuestionId  String?
  importId          String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // NUMERIC questions only; null for choice questions. Grading accepts
  // |submitted - answerNumeric| <= (answerTolerance ?? max(0.01, 0.005*|answerNumeric|)).
  answerNumeric   Float?
  answerTolerance Float? // absolute ±; null = default policy above
  answerUnit      String? // display-only unit suffix (may contain LaTeX), never graded

  // Optional figure the question depends on (cropped from a quiz PDF page).
  figureStorageKey String?
  figureBucket     String?
  figureAlt        String?

  quiz        Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdBy   Teacher?        @relation("TeacherQuestions", fields: [createdById], references: [id], onDelete: SetNull)
  import      QuestionImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  options     Option[]
  quizAnswers QuizAnswer[]
  simulation  QuestionSimulation?

  @@index([importId])
  // Quiz generation: WHERE quizId ORDER BY createdAt ASC
  @@index([quizId, createdAt])
  @@index([createdById])
}

// status: "COMPLETED" | "FAILED"
// teacherId is NULL when an admin imported straight into the global pool.
model QuestionImport {
  id            String   @id @default(cuid())
  teacherId     String?
  quizId        String   @map("subtopicId")
  originalName  String
  sourcePath    String?
  bankId        String?
  bankTitle     String?
  status        String   @default("COMPLETED")
  importedCount Int      @default(0)
  skippedCount  Int      @default(0)
  errorCount    Int      @default(0)
  errors        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher       Teacher?           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  quiz          Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questions     Question[]
  pdfExtraction QuizPdfExtraction?

  @@index([teacherId])
  @@index([quizId])
}

// ─── PDF Quiz Extraction (vision-LLM import pipeline) ─────────────────────────
// status: "PENDING_UPLOAD" | "EXTRACTING" | "AWAITING_REVIEW" | "COMMITTED" | "FAILED"
// teacherId is NULL when an admin extracts into a global-pool quiz.
// extractedQuestions holds the staged StagedQuestion[] JSON awaiting teacher
// review; on commit a QuestionImport row is created and linked so committed
// questions share the same provenance system as QTI imports.
model QuizPdfExtraction {
  id                 String   @id @default(cuid())
  quizId             String   @map("subtopicId")
  teacherId          String?
  originalName       String
  sizeBytes          Int
  storageKey         String // original PDF
  bucket             String
  status             String   @default("PENDING_UPLOAD")
  totalPages         Int      @default(0)
  errorMessage       String?
  hasAnswerKey       Boolean? // detected by the model; null until extracted
  extractedQuestions String? // JSON: StagedQuestion[]
  warnings           String   @default("[]") // JSON string[]
  // Set when the post-extraction guardrail audit flagged this document. Gives
  // the warning on the review screen an id the teacher can attach a "this is
  // wrong" report to; null whenever nothing tripped, which is the normal case.
  guardrailEventId   String?
  questionImportId   String?  @unique // set on commit

  // AI generation metrics from the extraction run (all passes aggregated).
  // Shown to teachers/admins on the review screen; null until extracted.
  aiModel  String?
  aiProvider String? // "openai" | "local" | "cloudflare"; null on runs from before it was recorded
  aiServiceTier String? // "flex" | "auto" | "default"; null when the model has no tier set
  aiThinkingLevel String? // reasoning effort the run was made with; null when the model has none pinned
  aiTtftMs Int?
  aiTokens Int?
  aiTotalMs Int? // total wall-clock time summed across all passes (ms)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  quiz    Quiz                      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  teacher Teacher?                  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  import  QuestionImport?           @relation(fields: [questionImportId], references: [id], onDelete: SetNull)
  pages   QuizPdfExtractionPage[]
  figures QuizPdfExtractionFigure[]

  @@index([quizId])
  @@index([teacherId])
}

model QuizPdfExtractionPage {
  id           String @id @default(cuid())
  extractionId String
  pageNumber   Int
  storageKey   String // rasterized page PNG in S3

  extraction QuizPdfExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  @@unique([extractionId, pageNumber])
  @@index([extractionId])
}

// Every figure / image-choice key this extraction has handed out a presigned PUT
// for. Commit accepts a key only if it is recorded here.
//
// A "does it start with the right prefix" test is satisfied by ANY object under
// the folder, so it cannot tell an issued crop apart from one the extraction
// never handed out. Recording the keys at issue time is what makes exact
// verification possible while the keys stay UUID-versioned (which is what keeps
// a retried crop from having to overwrite a write-once object).
//
// It also gives post-commit cleanup the list it needs: crops that were uploaded
// but never referenced by the commit can be deleted instead of accumulating
// under figures/, which the sweep otherwise preserves wholesale.
model QuizPdfExtractionFigure {
  id            String   @id @default(cuid())
  extractionId  String
  questionIndex Int
  // null for a per-question figure crop; set for an image answer choice.
  optionIndex   Int?
  storageKey    String   @unique
  createdAt     DateTime @default(now())

  extraction QuizPdfExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  @@index([extractionId])
}

model Option {
  id         String  @id @default(cuid())
  text       String
  isCorrect  Boolean @default(false)
  questionId String

  // Optional image choice (cropped from a quiz PDF page, like a question figure).
  // An image option stores text = "" (never null) so every option.text reader is
  // safe; imageAlt holds a short label/caption used as alt text.
  imageStorageKey String?
  imageBucket     String?
  imageAlt        String?

  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quizAnswers QuizAnswer[]

  // Loaded on every quiz fetch (include: { options }) and bulk-replaced on
  // question edit (deleteMany({ questionId })) — SQLite does not index FKs.
  @@index([questionId])
}

// ─── Class <-> Quiz (with publish control) ────────────────────────────────────

model ClassQuiz {
  id        String  @id @default(cuid())
  classId   String
  quizId    String
  published Boolean @default(false)

  // Per-class quiz availability + attempt controls. All nullable: existing rows
  // default to null = always open / unlimited attempts (no backfill needed).
  availableFrom  DateTime? // quiz opens (null = always open)
  availableUntil DateTime? // quiz closes (null = never closes)
  maxAttempts    Int? // total completed attempts allowed (null/0 = unlimited)

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  quiz  Quiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([classId, quizId])
  @@index([quizId])
}

// ─── Learning Progress ────────────────────────────────────────────────────────
// status: "NOT_STARTED" | "IN_PROGRESS" | "COMPLETED"

model QuizProgress {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  quizId    String   @map("subtopicId")
  status    String   @default("NOT_STARTED")
  bestScore Float?
  // Optional teacher-entered percentage (0-100). This overrides the best
  // attempt when grades are exported, without rewriting attempt history.
  manualGrade Float?
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, quizId])
  @@index([classId])
  @@index([quizId])
  @@map("ModuleProgress")
}

model QuizAttempt {
  id          String    @id @default(cuid())
  studentId   String
  classId     String
  quizId      String?   @map("subtopicId")
  score       Float?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  // SetNull (not Cascade): deleting a quiz — e.g. an admin pruning the global
  // pool — must never erase students' attempt history.
  quiz    Quiz?        @relation(fields: [quizId], references: [id], onDelete: SetNull)
  answers QuizAnswer[]

  // Latest-completed-attempt lookups: WHERE studentId AND completedAt IS NOT
  // NULL ORDER BY completedAt DESC (also serves plain studentId filters)
  @@index([studentId, completedAt])
  @@index([classId])
  @@index([quizId])
}

model QuizAnswer {
  id                String   @id @default(cuid())
  quizAttemptId     String
  questionId        String
  selectedOptionId  String?
  selectedOptionIds String   @default("[]")
  numericValue      Float? // student's response to a NUMERIC question; null otherwise
  isCorrect         Boolean  @default(false)

  quizAttempt    QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option?     @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([quizAttemptId])
  // FK cascade/SetNull targets — question delete and option delete (bulk
  // option replacement on question edit) scan this table without these.
  @@index([questionId])
  @@index([selectedOptionId])
}

// ─── Exam Results (durable archival snapshot) ─────────────────────────────────
// Deliberately RELATION-FREE: it stores plain id columns (no @relation), so no
// cascade can delete it when a Student/Class/Quiz/Question/QuizAttempt is
// removed, and a full self-contained snapshot of everything needed to render the
// results, so teacher edits/deletions of quiz questions never alter a past
// result. AI fields are populated asynchronously by the background worker.
// summaryStatus / recommendationsStatus: "PENDING" | "GENERATING" | "READY" | "FAILED"
model ExamResult {
  id            String @id @default(cuid())
  quizAttemptId String @unique
  studentId     String
  classId       String
  quizId        String @map("subtopicId")

  // identity snapshot — survives rename/deletion of the live rows
  studentName String?
  className   String
  topicName   String
  quizName    String @map("subtopicName")

  // score snapshot
  score        Float
  correctCount Int
  totalCount   Int
  completedAt  DateTime

  // self-contained per-question review snapshot (JSON string)
  reviewSnapshot String

  // AI content + independent generation status
  summary               String?
  summaryStatus         String  @default("PENDING")
  recommendations       String? // JSON: { items: StoredRecommendation[], truncated: boolean }
  recommendationsStatus String  @default("PENDING")

  // AI generation metrics for each student-visible generated section.
  // `aiModel` remains as a legacy last-used value; the per-section labels are
  // provider-qualified (for example "openai/gpt-5.5").
  // Provider, service tier, and thinking level are recorded per section from
  // this run's resolved assignment; all stay null on sections generated before
  // they were stored.
  aiModel                String?
  summaryAiModel         String?
  summaryAiProvider      String? // "openai" | "local" | "cloudflare"
  summaryServiceTier     String? // "flex" | "auto" | "default"
  summaryThinkingLevel   String? // reasoning effort; null when the model has none pinned
  summaryTtftMs          Int?
  summaryGenerationMs    Int?
  summaryTotalMs         Int?
  summaryTokens          Int?
  summaryTokensEstimated Boolean?
  recsAiModel            String?
  recsAiProvider         String?
  recsServiceTier        String?
  recsThinkingLevel      String?
  recsTtftMs             Int?
  recsGenerationMs       Int?
  recsTotalMs            Int?
  recsTokens             Int?
  recsTokensEstimated    Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, completedAt])
  @@index([classId])
}

// ─── AI Provider Configuration ────────────────────────────────────────────────
// providerType: "openai" | "local" | "cloudflare"

model AiProvider {
  id           String   @id @default(cuid())
  name         String                // human label, e.g. "Production OpenAI"
  providerType String                // "openai" | "local" | "cloudflare"
  baseUrl      String?               // null for OpenAI (uses default); URL for local or Cloudflare AI Gateway
  apiKeyEnc    String?               // AES-256-GCM encrypted bearer token (OpenAI key, or CF_AIG_TOKEN for cloudflare)
  apiKeyIv     String?
  apiKeyTag    String?

  // Cloudflare AI Gateway — only used when providerType = "cloudflare"
  cfAigByokAlias String?             // optional BYOK alias (sent as cf-aig-byok-alias header)

  // Per-request timeout (ms) applied to every AI call made with this provider.
  // null → fall back to DEFAULT_AI_TIMEOUT_MS (see src/lib/ai-provider.ts).
  timeoutMs    Int?

  // Which OpenAI-compatible endpoint to call: "responses" or "chat_completions".
  // null → the per-type default from `resolveApiSurface` (currently "responses"
  // everywhere). A "responses" call that the endpoint does not implement falls
  // back to /chat/completions on its own, so this is a preference, not a
  // promise — see src/lib/ai-streaming.ts.
  apiSurface   String?

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  models      AiModel[]
  assignments AiUseCaseAssignment[]
}

model AiModel {
  id          String   @id @default(cuid())
  providerId  String
  modelId     String                // e.g. "gpt-5.1", "llama-3.3-70b"
  displayName String?               // optional friendly name
  serviceTier String?               // "flex" | "auto" | "default" | null
  // LEGACY. Thinking level used to be pinned per model; it is now chosen per
  // use case on AiUseCaseAssignment. Nothing writes this column any more — the
  // admin assignments route carries a leftover value over to the assignments
  // using the model and then nulls it out. It stays declared because dropping a
  // column is a potential-data-loss change and the container entrypoint runs
  // `db push` without --accept-data-loss.
  thinkingLevel String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  provider    AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  assignments AiUseCaseAssignment[]

  // `thinkingLevel` is NOT part of this key, and adding it never was an option:
  // adding a column to a unique constraint is a potential-data-loss change, and
  // the container entrypoint runs `db push` without --accept-data-loss in
  // production on purpose. Moot now that the level is per use case — a model id
  // registered once can serve several use cases at different efforts.
  @@unique([providerId, modelId, serviceTier])
  @@index([providerId])
}

// useCase: "pdf_description" | "description_generation" | "recommendation" |
//          "quiz_extraction" | "simulation_generation" | "student_assistant" |
//          "teacher_assistant"
model AiUseCaseAssignment {
  id         String   @id @default(cuid())
  useCase    String   @unique       // only one assignment per use case
  providerId String
  modelId    String
  // Reasoning/thinking effort sent as `reasoning_effort` on every call made for
  // this use case: "none" | "minimal" | "low" | "medium" | "high" | "xhigh" |
  // "max" | null. null (the default) omits the parameter entirely, so models
  // that don't support thinking are unaffected — see src/lib/ai-provider.ts.
  // Per use case rather than per model on purpose: the same model is often
  // assigned to both a cheap bulk job and an interactive assistant, which want
  // different efforts.
  thinkingLevel String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  model    AiModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

// ─── Assistant (chat bot) configuration ───────────────────────────────────────
// One row per audience: "student" and "teacher". The id IS the audience so the
// row is addressable without a lookup (mirroring SmtpConfig's "singleton" id).
//
// The provider/model each assistant talks to is NOT stored here — it comes from
// AiUseCaseAssignment under the "student_assistant" / "teacher_assistant" use
// cases, so assistants share the same provider plumbing (OpenAI / local /
// Cloudflare AI Gateway) and connection tester as every other AI feature. This
// row holds only the *behavior* knobs an admin tunes per audience.
// ─── Guardrails ────────────────────────────────────────────────────────────────
// Singleton row holding the safety policy applied across every AI path. Which
// MODEL runs the checks lives in AiUseCaseAssignment ("moderation" and
// "guardrail"); this row is the behaviour around them — on/off, report vs
// block, thresholds, and what counts as on-topic.
//
// A missing row behaves exactly like the shipped defaults (see
// src/lib/guardrail-settings.ts), so a fresh install and an upgraded one act
// the same without a seed step.
model GuardrailConfig {
  id String @id @default("singleton") // enforce a single row

  // Free /v1/moderations pass. Independent of the LLM checks below: it costs
  // nothing, so it stays on unless an admin deliberately turns it off.
  moderationEnabled Boolean @default(true)

  // "OFF" | "FLAG" | "BLOCK" — see GuardrailMode in src/lib/guardrail-check.ts.
  // Both ship in report-only mode: enforcing a threshold nobody has calibrated
  // against this site's own uploads is guesswork, and FLAG writes the same log
  // rows so an admin can read real traffic before switching to BLOCK.
  jailbreakMode String @default("FLAG")
  offTopicMode  String @default("OFF")

  // Minimum confidence (0-1) at which a detection counts.
  jailbreakThreshold Float @default(0.7)
  offTopicThreshold  Float @default(0.7)

  // What counts as on-topic, in the admin's own words. Empty = the built-in
  // STEM-education description in src/lib/guardrail-check.ts.
  topicDescription String @default("")

  // What happens when a check CANNOT run (no provider, timeout, upstream 5xx).
  // true  -> allow, and log. A guardrail outage must not stop a class working.
  // false -> reject request-path submissions. Worker jobs (PDF processing) stay
  //          fail-open regardless: failing them would strand an upload the
  //          teacher is waiting on, with no way for them to retry the check.
  failOpen Boolean @default(true)

  // JSON array of surface keys switched off entirely (see GUARDRAIL_SURFACES in
  // src/lib/guardrail-settings.ts). An opt-OUT list, matching AssistantConfig's
  // disabledTools: a surface added in a later release is guarded by default
  // rather than staying dark until an admin re-saves.
  disabledSurfaces String @default("[]")

  updatedAt DateTime @updatedAt
}

// ─── Guardrail findings a user was shown, and their feedback on them ──────────
// One row per guardrail finding that reached a USER: a submission that was
// refused, or a warning attached to work they are about to review. This is NOT
// the audit trail — every check writes that to SystemLog under the GUARDRAIL
// category whether anyone saw it or not. These rows exist so the notice a user
// reads can carry an id, which is the only way a false positive travels back to
// an admin instead of dying as a shrug at the screen.
//
// Written only when something actually tripped, so the table stays small.

model GuardrailEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Surface key, e.g. "assistant_chat" (see GUARDRAIL_SURFACES).
  surface   String
  // Row the content belonged to, when there is one. No FK: the content is
  // frequently never stored, because the check is what stopped it.
  subjectId String?
  // Who saw the notice. No FK, matching SystemLog — an event outlives the
  // account, and a guardrail record that vanishes on user deletion is worth
  // less than one that keeps the surface and the reason.
  userId    String?

  // true  -> the submission was refused.
  // false -> it went through with a warning the user can read.
  blocked Boolean @default(true)
  // JSON array of trip descriptions, e.g. ["jailbreak (0.92)"]. Admin-only:
  // the user-facing message never names the check that fired.
  reasons String  @default("[]")

  feedback GuardrailFeedback?

  @@index([createdAt])
  @@index([userId, createdAt])
}

model GuardrailFeedback {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // One report per event: a second submission edits the first rather than
  // stacking, so a frustrated user cannot flood the review queue.
  eventId String         @unique
  event   GuardrailEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Who reported it. No FK, for the same reason as GuardrailEvent.userId.
  userId  String?
  message String

  // "NEW" | "REVIEWED" | "DISMISSED" — see GUARDRAIL_FEEDBACK_STATUSES in
  // src/lib/guardrail-events.ts.
  status     String    @default("NEW")
  reviewedAt DateTime?
  reviewedBy String?

  @@index([status, createdAt])
  @@index([createdAt])
}

model AssistantConfig {
  id       String @id // "student" | "teacher" — see ASSISTANT_AUDIENCES
  audience String @unique

  enabled Boolean @default(false)

  // Appended to the built-in system prompt (never replaces it — the built-in
  // half carries the safety rules). Empty/null = built-in prompt only.
  extraInstructions String?

  // JSON array of skill ids (see src/lib/assistant/skills). Only skills
  // registered for this audience are loaded; unknown ids are ignored, so
  // removing a skill from the code can never break a saved config.
  enabledSkills String @default("[]")

  // JSON array of tool names switched OFF inside the enabled skills. Stored as
  // an opt-OUT list rather than an allow-list on purpose: a tool added to a
  // skill in a later release is then available to every existing row instead of
  // silently staying dark until an admin re-saves the form.
  disabledTools String @default("[]")

  // Multimodal input limits. attachmentKinds is a JSON array drawn from the
  // registry in src/lib/assistant/attachments.ts ("image" | "text" | "csv");
  // adding a kind there (pdf, …) makes it selectable here without a migration.
  attachmentKinds    String @default("[\"image\"]")
  maxAttachments     Int    @default(4)
  maxAttachmentBytes Int    @default(5242880) // 5 MiB per attachment

  // How long an uploaded chat attachment is kept before the worker's retention
  // sweep deletes the row and its S3 object. See AssistantAttachment.
  attachmentRetentionDays Int @default(30)

  // How far back a user may browse their own chat history, in days. This is a
  // VISIBILITY window, not a deletion one: past the cutoff the conversation
  // stops being listed or readable by the user who had it, and the worker moves
  // it out of the hot tables into S3, where it stays for admins indefinitely.
  // See AssistantConversation.
  historyRetentionDays Int @default(30)

  // Agent loop bounds. maxToolCalls caps tool-calling rounds per turn;
  // maxHistoryMessages caps how much client-supplied transcript is replayed.
  maxToolCalls       Int @default(6)
  maxHistoryMessages Int @default(20)

  // Per-user turn budget, enforced in-process like src/lib/rate-limit.ts.
  turnsPerHour Int @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One file a user attached to a chat-assistant turn. The bytes live in S3 under
// `assistant-attachments/{userId}/{id}/`; this row is the index the app reads
// them back through, plus the expiry the worker sweeps on
// (AssistantConfig.attachmentRetentionDays, 30 days by default). Keeping the
// payload out of the row matters: a handful of 5 MiB base64 blobs per chat turn
// would bloat both the SQLite file and every nightly backup of it.
//
// Deliberately RELATION-FREE, like ExamResult: the row is what authorizes and
// locates the object, so a cascade delete would silently orphan bytes in the
// bucket that nothing could ever find again. Deleting a user therefore leaves
// their attachments to the retention sweep, which removes object and row
// together — the one place that deletion is complete.
//
// The write order is row-first, then upload: an object can never exist without a
// row pointing at it, so the sweep is the only deleter it needs.
model AssistantAttachment {
  id       String @id @default(cuid())
  userId   String
  audience String // "student" | "teacher" — the assistant it was sent to

  name     String // original filename, for display
  mimeType String
  kind     String // AttachmentKind: "image" | "text" | "csv" | …
  bytes    Int

  storageKey String
  bucket     String

  createdAt DateTime @default(now())
  expiresAt DateTime

  // Retention sweep (expiresAt < now) and per-user reads of a known id.
  @@index([expiresAt])
  @@index([userId, createdAt])
}

// ─── Chat transcripts ─────────────────────────────────────────────────────────
// One chat-assistant conversation. Transcripts are stored in TWO TIERS, and
// `archivedAt` is the single flag that says which one holds the turns:
//
//   HOT  (archivedAt == null): turns are AssistantMessage rows. This is the
//        window the user can still browse, so listing and reading it is a plain
//        indexed query and an admin can search the text with SQL.
//   COLD (archivedAt != null): turns were written to ONE newline-delimited JSON
//        object at `storageKey` and the rows were dropped. Admin-only, kept
//        indefinitely.
//
// The tier boundary IS the user's visibility window
// (AssistantConfig.historyRetentionDays): the worker archives a conversation
// exactly when it ages out of what its owner may see. That alignment is what
// keeps the hot tables — and therefore every nightly backup of the SQLite file —
// bounded by retention rather than by total chat volume, while nothing is ever
// actually deleted.
//
// Access is enforced on `lastMessageAt`, NOT on `archivedAt`: a user is outside
// their window the moment the cutoff passes, whether or not the sweep has run.
// The archive state is a storage detail and must never be the thing a permission
// check depends on.
//
// Deliberately relation-free on `userId`, like AssistantAttachment: deleting a
// user must not silently drop the transcripts an admin is expected to retain,
// nor orphan the S3 objects that nothing would then be able to find.
model AssistantConversation {
  id       String @id @default(cuid())
  userId   String
  audience String // "student" | "teacher" — the assistant that answered

  // First user message, truncated. Denormalized so the history list renders
  // without reading a single turn (and still works once the turns are in S3).
  title String

  messageCount  Int      @default(0)
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  // Cold-tier location. All three are set together, and only by the archiver.
  archivedAt DateTime?
  storageKey String?
  bucket     String?

  messages AssistantMessage[]

  // User's own history list, newest first, cut off at the retention window.
  @@index([userId, lastMessageAt])
  // Admin browsing, filtered by audience.
  @@index([audience, lastMessageAt])
  // Archive sweep: hot rows whose window has closed.
  @@index([archivedAt, lastMessageAt])
}

// One turn of a HOT conversation. Rows exist only while the conversation is in
// the hot tier — the archiver writes them to S3 and deletes them, which is why
// every read path has to go through the conversation row rather than querying
// here directly.
model AssistantMessage {
  id             String @id @default(cuid())
  conversationId String

  // Position within the conversation, 0-based and gap-free. Ordering is by THIS
  // and never by `createdAt`: two turns can share a millisecond, and a
  // transcript that renders its answer above its question is worse than one that
  // renders a millisecond out of order. The append transaction derives it from
  // the conversation's own message count, so concurrent writers can't collide.
  seq Int

  role    String // "user" | "assistant"
  content String

  // JSON arrays mirroring AssistantTurn on the wire: the attachment ids let a
  // resumed conversation replay its files, the names survive the attachment's
  // own (shorter) retention so an expired file still reads as "they sent one".
  attachmentIds   String @default("[]")
  attachmentNames String @default("[]")

  createdAt DateTime @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, seq])
}

// ─── Email / Notifications ─────────────────────────────────────────────────────
// Singleton SMTP server configuration, managed by admins. The SMTP password is
// encrypted at rest with AES-256-GCM (see src/lib/crypto.ts), mirroring the way
// AI provider API keys are stored.
model SmtpConfig {
  id          String  @id @default("singleton") // enforce a single row
  host        String
  port        Int     @default(465)
  secure      Boolean @default(true)            // true = implicit TLS (port 465); derived from port in the admin UI

  username    String?                            // SMTP auth username (often the from address)
  passwordEnc String?                            // AES-256-GCM encrypted SMTP password
  passwordIv  String?
  passwordTag String?

  fromEmail   String                             // fallback envelope/from address
  fromName    String?                            // fallback display name

  // Shared domain for the per-purpose sender addresses below, stored without
  // the "@" (e.g. "edwarcheng.net"). When set, each EmailSender's localPart is
  // combined with it — password-reset@edwarcheng.net, notification@… — and
  // fromEmail is only used as a fallback. Blank = every purpose uses fromEmail.
  senderDomain String?

  isActive    Boolean  @default(false)           // email sending only enabled when true
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Per-purpose sender identity and (where the app writes the copy) message
// template. One row per purpose key from EMAIL_PURPOSES in
// src/lib/email-purposes.ts; missing rows fall back to that catalog's defaults,
// so the table is an override layer rather than required configuration.
model EmailSender {
  id      String @id @default(cuid())
  purpose String @unique // EmailPurpose key, e.g. "PASSWORD_RESET"

  localPart String  // address prefix, combined with SmtpConfig.senderDomain
  fromName  String? // display name override; falls back to SmtpConfig.fromName
  replyTo   String? // optional Reply-To; blank means "no reply expected"

  // Subject/body overrides for app-generated emails. Null keeps the built-in
  // template. Purposes whose body is authored by a user (class announcements,
  // student→teacher messages) ignore these.
  subject String?
  body    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Single-use, time-limited password reset grants. Only the SHA-256 hash of the
// emailed token is stored, so a database leak can't be replayed into account
// takeover. Rows are consumed (usedAt) rather than deleted so a reused link can
// be told apart from an unknown one in the logs.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Invalidate-all-for-user on issue/consume, and expiry sweeps.
  @@index([userId])
  @@index([expiresAt])
}

// ─── Database backups ──────────────────────────────────────────────────────────
// Singleton WebDAV backup configuration, managed by admins. The WebDAV password
// is encrypted at rest with AES-256-GCM (see src/lib/crypto.ts), mirroring
// SmtpConfig. Snapshots are pushed to `<baseDir>/<env>/` (prod|dev) by the
// worker, and the admin "Restore" flow stages any of them for the next boot.
model BackupConfig {
  id String @id @default("singleton")

  webdavUrl      String?
  webdavUsername String?
  passwordEnc    String? // AES-256-GCM encrypted WebDAV password
  passwordIv     String?
  passwordTag    String?
  baseDir        String  @default("/backups")

  enabled       Boolean @default(false)
  intervalHours Int     @default(24)
  anchorTime    String  @default("02:00") // HH:mm interpreted in `timezone`
  timezone      String  @default("America/New_York")

  // Grandfather-father-son retention — how many to keep in each tier.
  keepRecent  Int @default(7)
  keepWeekly  Int @default(4)
  keepMonthly Int @default(12)
  keepYearly  Int @default(3)

  // Status of the most recent run (surfaced in the admin UI).
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  lastStatus    String? // "SUCCESS" | "FAILED" | "RUNNING"
  lastError     String?
  lastBackupKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A message either broadcast from a teacher to the students on a class roster,
// or sent from a single student to their teacher. Persisted for an audit trail
// regardless of delivery outcome — and, for the in-app channel, the source row
// the per-recipient Notification rows point back to for subject/body.
// direction: "TEACHER_TO_STUDENTS" | "STUDENT_TO_TEACHER"
// channels:  comma-joined of "IN_APP" | "EMAIL" (e.g. "IN_APP,EMAIL"). The
//            recipientCount/sentCount/status/error fields below describe the
//            EMAIL send only; inAppCount is the number of in-app recipients.
// status:    "QUEUED" | "SENT" | "PARTIAL" | "FAILED" (email outcome; "SENT"
//            when no email was queued). Teacher→student email is delivered by
//            the worker off the request path, so a fresh broadcast starts
//            "QUEUED" and settles once every MessageEmailDelivery finishes.
model Message {
  id             String   @id @default(cuid())
  classId        String?
  direction      String
  channels       String   @default("EMAIL") // existing rows predate in-app, so default to email
  senderUserId   String
  subject        String
  body           String
  recipientCount Int      @default(0) // email recipients attempted
  sentCount      Int      @default(0) // email recipients delivered
  inAppCount     Int      @default(0) // in-app notification recipients
  status         String   @default("SENT")
  error          String?
  createdAt      DateTime @default(now())

  class         Class?                 @relation(fields: [classId], references: [id], onDelete: SetNull)
  sender        User                   @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  notifications Notification[]
  emailDeliveries MessageEmailDelivery[]

  @@index([classId])
  @@index([senderUserId])
  @@index([direction])
  // Email quota: WHERE senderUserId AND channels LIKE '%EMAIL%' AND createdAt >= window
  @@index([senderUserId, createdAt])
}

// One outbound email for ONE recipient of a Message — the durable record the
// `message-emails` Honker queue works from (see src/lib/message-email.ts).
// Rows are written PENDING in the same request that creates the Message, so
// the intent to email survives a crashed request, a restarted worker, a lost
// job, or an SMTP outage: the worker retries with backoff, and a sweeper
// re-enqueues anything still PENDING past its nextAttemptAt.
//
// status:        "PENDING" | "SENT" | "FAILED" (FAILED = permanently given up)
// attempts:      delivery attempts made so far, capped by MESSAGE_EMAIL_MAX_ATTEMPTS
// nextAttemptAt: earliest time the next attempt may run (backoff schedule)
// claimedAt:     lease held by the worker currently attempting this row; a
//                stale lease is reclaimable so a killed worker can't strand it.
//                The lease is what makes duplicate jobs harmless — only one
//                claimant can move a row, so a recipient is emailed once.
model MessageEmailDelivery {
  id            String    @id @default(cuid())
  messageId     String
  userId        String? // recipient's User; null when the address came from the roster only
  email         String
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  claimedAt     DateTime?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // One row per recipient address per message — makes re-queueing idempotent.
  @@unique([messageId, email])
  // Per-message delivery summary shown in the teacher's message history.
  @@index([messageId, status])
  // Sweeper: WHERE status = 'PENDING' AND nextAttemptAt <= now
  @@index([status, nextAttemptAt])
}

// One in-app notification delivered to a single student (their User). The
// subject/body live on the parent Message; this row carries per-recipient read
// state and powers the student mailbox.
model Notification {
  id        String    @id @default(cuid())
  messageId String
  userId    String // recipient student's user id
  readAt    DateTime?
  createdAt DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  // Mailbox list + unread badge: WHERE userId ORDER BY createdAt DESC; unread count
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([messageId])
}

// ─── Concept & Misconception catalog ──────────────────────────────────────────
// Admin-managed reference catalog imported from spreadsheet exports (see
// src/lib/concept-csv.ts). Deliberately no FK/relation onto Question or
// LearningMaterial yet — concept↔question / concept↔material tagging is out of
// scope for this slice.

model Concept {
  id              String   @id @default(cuid())
  conceptId       String   @unique          // "F-FV-1", "AP-2.2.A"
  kind            String                    // detailed_lo | ap_lo | ap_lo_child
  parentApLo      String?                   // parent conceptId as plain string (no FK; parents may be deprecated)
  unit            String?
  topic           String?
  displayName     String
  description     String?
  sourceLoCode    String?
  comments        String?
  notes           String?
  url             String?
  deprecated      Boolean  @default(false)
  deprecationNote String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  misconceptionLinks ConceptMisconception[]

  @@index([deprecated])
}

model Misconception {
  id              String   @id @default(cuid())
  misconceptionId String   @unique          // "MIS-001"
  statement       String
  sourceCitation  String?
  link            String?
  sourceType      String?
  notes           String?
  deprecated      Boolean  @default(false)
  deprecationNote String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conceptLinks ConceptMisconception[]

  @@index([deprecated])
}

model ConceptMisconception {
  id              String   @id @default(cuid())
  misconceptionId String
  conceptId       String
  confidence      String?  // High | Medium | Low
  notes           String?
  createdAt       DateTime @default(now())

  misconception Misconception @relation(fields: [misconceptionId], references: [misconceptionId], onDelete: Cascade)
  concept       Concept       @relation(fields: [conceptId], references: [conceptId], onDelete: Cascade)

  @@unique([misconceptionId, conceptId])
}

model ConceptExternalRef {
  id        String   @id @default(cuid())
  conceptId String                          // plain string, soft reference
  refCode   String                          // "F-FF-1.M1", "MC-LIU-20"
  refType   String                          // heuristic | primary
  sourceUrl String?
  createdAt DateTime @default(now())

  @@unique([conceptId, refCode, refType])
}

// ─── Question simulations (AI-generated interactive HTML) ─────────────────────
// One optional simulation per question: a self-contained HTML/JS page teaching
// the question's BROAD topic (never the question's numbers, scenario, or
// answer — it is shown to students post-quiz while results are still blind).
// The artifact lives in S3; every (re)generation writes a NEW versioned key and
// old objects are never deleted, because deep-copied questions share keys the
// same way figures do (see deepCopyQuiz).
// status: "PENDING"   queued/in-flight first generation (no artifact yet)
//         "REVISING"  queued/in-flight feedback revision (old artifact stays visible)
//         "READY" | "DECLINED" | "FAILED" terminal until re-triggered
model QuestionSimulation {
  id         String @id @default(cuid())
  questionId String @unique
  status     String @default("PENDING")

  // What the simulation teaches — broad topic only, set by the triage call.
  topic        String?
  title        String?
  learningGoal String?

  // Triage's stated reason when it declines (helpful=false); shown to staff.
  declineReason String?
  errorMessage  String?

  // Current HTML artifact. null until first READY. version counts uploads.
  storageKey String?
  bucket     String?
  version    Int     @default(0)

  // Build spec (plain text) produced by triage; revisions are generated from
  // this spec + feedback, never from the raw question (leakage firewall).
  simSpec String?

  sourceSimulationId String? // lineage: the sim this row was deep-copied from (plain id, no FK)

  // AI generation metrics, aggregated across the most recent job's calls.
  // Rows written before aiProvider existed hold a provider-qualified aiModel
  // ("cloudflare/openai/gpt-5.5"); newer rows keep the two apart.
  aiModel           String?
  aiProvider        String? // "openai" | "local" | "cloudflare"
  aiServiceTier     String? // "flex" | "auto" | "default"
  aiThinkingLevel   String? // reasoning effort the run was made with; null when none pinned
  aiTtftMs          Int?
  aiGenerationMs    Int?
  aiTotalMs         Int?
  aiTokens          Int?
  aiTokensEstimated Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  feedback SimulationFeedback[]

  @@index([status])
}

// One teacher/admin correction round on a simulation ("the period formula is
// wrong", "sliders overflow"). Each row drives one revision job.
// status: "PENDING" | "APPLIED" | "FAILED"
model SimulationFeedback {
  id           String @id @default(cuid())
  simulationId String
  authorUserId String // plain User id (no FK; feedback must survive account deletion)
  authorName   String?
  feedback     String
  status       String @default("PENDING")
  errorMessage String?

  // The storageKey the simulation had when this feedback was applied, kept so
  // staff can compare versions.
  previousStorageKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  simulation QuestionSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId, createdAt])
}

// ─── Simulation telemetry ─────────────────────────────────────────────────────
// One row per simulation open on the student results page. Deliberately
// RELATION-FREE (plain id columns, like ExamResult) so engagement history
// survives deletion of simulations/quizzes/students. Counters are cumulative
// per-session totals reported by the client and clamped server-side — they are
// engagement signal, not ground truth. surface: "rail" | "mobile".
model SimulationSession {
  id           String @id @default(cuid())
  simulationId String
  studentId    String
  classId      String?
  quizId       String?
  attemptId    String? // the quiz attempt whose results page surfaced the sim
  surface      String

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  dwellMs          Int     @default(0) // wall-clock ms the viewer was open
  activeMs         Int     @default(0) // ms with recent in-sim activity
  interactionCount Int     @default(0) // pointer/key interactions inside the sim
  paramChanges     Int     @default(0) // control (slider/select/…) changes
  controlsJson     String? // JSON {controlLabel: changeCount}, capped + sanitized

  updatedAt DateTime @updatedAt

  @@index([simulationId, startedAt])
  @@index([studentId, startedAt])
  @@index([quizId, startedAt])
  @@index([classId, startedAt])
}

// ─── System operation log ─────────────────────────────────────────────────────
// Admin-viewable operational log persisted for error diagnosis: auth events
// (failed / successful / throttled logins), API route errors, worker job
// failures, and periodic traffic samples (request + unique-IP counts).
// Deliberately RELATION-FREE (plain userId column) so the audit trail survives
// user deletion. Rows are pruned by the worker after SYSTEM_LOG_RETENTION_DAYS
// (default 90). Writes go through src/lib/system-log.ts and are best-effort —
// logging must never break the flow that emits it.
// category: "AUTH" | "API" | "WORKER" | "USAGE" | "SYSTEM"
// severity: "INFO" | "WARNING" | "ERROR"
model SystemLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  category  String
  type      String // e.g. "LOGIN_FAILED", "JOB_FAILED", "USAGE_SAMPLE", or an API route tag
  severity  String   @default("INFO")
  message   String
  userId    String? // acting/affected user when known (no FK on purpose)
  ip        String? // best-effort client IP from the proxy chain
  metadata  String? // JSON-as-text detail payload (SQLite has no JSON type)

  // Admin list: newest-first, optionally narrowed by category/severity/type.
  @@index([createdAt])
  @@index([category, createdAt])
  @@index([severity, createdAt])
  @@index([type, createdAt])
}

// ─── Node resource monitoring ─────────────────────────────────────────────────
// One row per node per sample tick (default 60s), written independently by
// every running process: the web server and the background worker of each
// deployment. See src/lib/resource-metrics.ts (collection) and
// src/lib/resource-monitor.ts (persistence + read model).
//
// Prod and dev have completely independent databases, so a given database only
// ever holds its OWN environment's two nodes; the admin page merges the peer
// environment's series over HTTP (src/lib/resource-peer.ts). That split is also
// why the storage columns are environment-scoped and need no extra filtering —
// dbBytes measures the volume this deployment mounts and s3Bytes the objects
// under its own S3_KEY_PREFIX, so dev rows only ever describe dev storage.
//
// Deliberately RELATION-FREE (like SystemLog): telemetry must never constrain
// deletes. Rows are pruned by the worker after RESOURCE_SAMPLE_RETENTION_DAYS
// (default 7) — the admin UI only charts back one week.
// appEnv: "prod" | "dev" — role: "web" | "worker"
// RETIRED — nothing writes here any more. The admin resource monitor moved its
// samples to a spool directory bind-mounted into all four containers, so that
// prod and dev can each chart the other's nodes without a cross-deployment HTTP
// call (see src/lib/resource-spool.ts). The worker keeps pruning the leftover
// rows until they age out.
//
// The model itself stays because docker-entrypoint.sh runs `prisma db push`
// WITHOUT --accept-data-loss in production: dropping a table is a destructive
// change, so removing this would make the container refuse to boot. Deleting it
// needs a deliberate migration, not a schema edit.
model ResourceSample {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  nodeId    String // "<appEnv>-<role>", e.g. "prod-worker"
  appEnv    String
  role      String
  hostname  String

  // Container-scoped when cgroups are readable (the Docker deployments),
  // process/host-scoped otherwise (bare `npm run dev`).
  cpuPercent    Float // 0-100, share of this node's available CPU capacity
  cpuCores      Float // cores the node may use (cgroup quota, else host count)
  memUsedBytes  Float
  memLimitBytes Float

  // Bytes are Float (not Int) because Prisma's Int is 32-bit and a bucket or a
  // disk easily exceeds 2 GiB.
  dbBytes        Float // this environment's SQLite data directory
  diskTotalBytes Float // filesystem backing that directory
  diskFreeBytes  Float
  s3Bytes        Float? // total under S3_KEY_PREFIX; only the worker scans the
  // bucket (hourly), so web-node rows leave this null

  @@index([createdAt])
  @@index([nodeId, createdAt])
}

// ─── IRB research consent ──────────────────────────────────────────────────
// Every account must record an explicit decision (AGREE or DECLINE) on the
// form version active for their role before continuing to use the platform —
// see src/lib/consent.ts and docs/plans/consent-compliance-plan.md. Storage is
// deliberately minimal: a signature/initial is small vector stroke-path JSON
// (not a rendered image), and the legal text itself lives once per version
// rather than being copied onto every signature (see ConsentFormVersion
// below). PDFs are generated on demand from these rows (src/lib/consent-pdf.ts)
// and are never persisted for an individual signature.

model ConsentFormVersion {
  id          String   @id @default(cuid())
  role        String   // "STUDENT" | "TEACHER"
  version     String   // e.g. "2026-08-06"
  title       String
  bodyHtml    String   // canonical form text rendered into the modal + PDF
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdById String?  // admin who published it (plain id, no FK — survives account deletion)

  records ConsentRecord[]

  @@unique([role, version])
  @@index([role, isActive])
}

// decision: "AGREE" | "DECLINE". deviceType: "desktop" | "mobile" | "tablet" | "unknown".
// userId is nullable + SetNull (not Cascade): the legal record of a decision
// must survive account deletion, so signerNameSnapshot/signerEmailSnapshot
// freeze who signed independent of the live account.
model ConsentRecord {
  id                        String   @id @default(cuid())
  userId                    String?
  user                      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role                      String   // snapshot of role at signing time
  formVersionId             String
  formVersion               ConsentFormVersion @relation(fields: [formVersionId], references: [id])
  decision                  String
  interviewRecordingConsent Boolean?
  initialsStrokeData        String?  // vector path JSON; only set when interviewRecordingConsent is true
  signatureTypedName        String   // "typing your name is equivalent to your legal signature"
  signatureStrokeData       String?  // optional hand-drawn vector JSON, if drawn instead of / in addition to typed
  signedAt                  DateTime @default(now())
  ipAddress                 String
  userAgent                 String
  deviceType                String
  signerNameSnapshot        String
  signerEmailSnapshot       String
  emailedAt                 DateTime?
  emailStatus               String?
  emailError                String?

  @@index([userId])
  @@index([role, decision])
}

// A teacher's request to export which students on a class roster have signed
// the student consent form (for awarding participation credit), gated by
// admin approval. status: "PENDING" | "APPROVED" | "REJECTED". Approval
// requires courseEndedAttested — the admin's on-record confirmation that the
// course has ended, per the signed consent form's promise that a student's
// participation is never known to their instructor while enrolled.
model ConsentExportRequest {
  id                  String   @id @default(cuid())
  teacherId           String
  teacher             Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId             String
  class               Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  gradeColumnName     String   // eLC header name, e.g. "Consent Credit"
  pointsAwarded       Float
  reviewerId          String   // admin the teacher chose
  reviewer            User     @relation("ConsentExportReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  status              String   @default("PENDING")
  courseEndedAttested Boolean  @default(false)
  decisionNote        String?
  decidedAt           DateTime?
  requestedAt         DateTime @default(now())
  deliveredAt         DateTime?
  emailStatus         String?
  emailError          String?

  @@index([status])
  @@index([reviewerId, status])
  @@index([teacherId])
}

// Queued delivery for consent-related emails (confirmation copy, export
// request/approval notices), mirroring MessageEmailDelivery's claim/backoff
// shape rather than reusing that table, so the messaging system stays
// untouched. kind: "CONSENT_CONFIRMATION" | "CONSENT_EXPORT_REQUEST" |
// "CONSENT_EXPORT_READY". status: "PENDING" | "SENT" | "FAILED".
model ConsentEmailDelivery {
  id            String    @id @default(cuid())
  kind          String
  recipient     String
  payload       String    // JSON: template vars + optional attachment source ids
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  claimedAt     DateTime?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
}

// A bulk admin PDF export, run entirely in the background worker — never
// inline in a web request, since generating/compressing many PDFs is
// CPU-bound work that would otherwise stall every other request on the same
// process (see docs/plans/consent-compliance-plan.md §8).
// status: "PENDING" | "PROCESSING" | "COMPLETE" | "FAILED".
model ConsentExportJob {
  id               String    @id @default(cuid())
  requestedById    String    // admin user id (plain id, no FK)
  filter           String    // JSON: role / date-range / explicit record ids
  status           String    @default("PENDING")
  totalRecords     Int?
  processedRecords Int       @default(0)
  resultBucket     String?
  resultKey        String?
  resultBytes      Int?
  expiresAt        DateTime?
  error            String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([status])
  @@index([requestedById])
}

// Global, admin-editable resource limits for consent PDF/export generation —
// singleton row, mirrors SmtpConfig/BackupConfig.
model ConsentExportSettings {
  id                        String   @id @default("singleton")
  maxEmailAttachmentBytes   Int      @default(5000000)
  bulkExportBatchSize       Int      @default(25)
  bulkExportInlineThreshold Int      @default(10)
  bulkExportMaxRecords      Int      @default(2000)
  bulkExportRetentionHours  Int      @default(48)
  updatedAt                 DateTime @updatedAt
  updatedById               String?
}
