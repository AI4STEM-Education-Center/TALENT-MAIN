generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Users ────────────────────────────────────────────────────────────────────
// role: "TEACHER" | "STUDENT"

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  username       String   @unique
  hashedPassword String
  firstName      String
  lastName       String
  role           String   @default("STUDENT")
  createdAt      DateTime @default(now())

  teacher Teacher?
  student Student?

  sentMessages  Message[]      @relation("MessageSender")
  notifications Notification[] @relation("UserNotifications")

  @@index([role])
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per-teacher email sending caps (recipient-emails). null = use the global
  // default (see DEFAULT_EMAIL_DAILY_LIMIT / DEFAULT_EMAIL_MONTHLY_LIMIT in
  // src/lib/email-limits.ts). Admins override these per teacher.
  emailDailyLimit   Int?
  emailMonthlyLimit Int?

  classes           Class[]
  topics            Topic[]             @relation("TeacherTopics")
  quizzes           Quiz[]              @relation("TeacherQuizzes")
  questions         Question[]          @relation("TeacherQuestions")
  questionImports   QuestionImport[]
  learningMaterials LearningMaterial[]
  pdfExtractions    QuizPdfExtraction[]
}

// Uploaded learning materials (S3 only). uploadStatus: "PENDING" | "READY" | "FAILED"
model LearningMaterial {
  id           String  @id @default(cuid())
  teacherId    String
  classId      String?
  title        String?
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  bucket       String
  uploadStatus String  @default("PENDING")
  processingStatus String @default("IDLE")
  folder       String?
  totalPages     Int     @default(0)
  processedPages Int     @default(0)
  errorMessage   String?
  batchDescription  String?
  batchKeyConcepts  String  @default("[]")

  // AI generation metrics from the most recent VLM processing run. Shown to
  // teachers/admins; null until the material is processed.
  aiModel  String?
  aiTtftMs Int? // time to first token (ms)
  aiTokens Int? // generated tokens summed across all page + batch calls

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  pages   MaterialPage[]
  classLinks MaterialClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([classId])
}

// Junction: a material can be shared across multiple of a teacher's classes.
model MaterialClass {
  id         String   @id @default(cuid())
  materialId String
  classId    String
  createdAt  DateTime @default(now())

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  class    Class            @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([materialId, classId])
  @@index([classId])
  @@index([materialId])
}

model MaterialPage {
  id           String  @id @default(cuid())
  materialId   String
  pageNumber   Int
  storageKey   String

  // Tier 1 VLM results (null = not yet processed)
  needed       Boolean?
  keyConcept   String?
  description  String?

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([materialId, pageNumber])
  @@index([materialId])
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enrollments  ClassEnrollment[]
  quizProgress QuizProgress[]
  quizAttempts QuizAttempt[]
}

// ─── Classes ──────────────────────────────────────────────────────────────────

model Class {
  id          String   @id @default(cuid())
  name        String
  description String?
  teacherId   String
  createdAt   DateTime @default(now())

  teacher        Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments    ClassEnrollment[]
  invitations    Invitation[]
  classQuizzes   ClassQuiz[]
  quizProgress   QuizProgress[]
  quizAttempts   QuizAttempt[]
  studentList    ClassStudentList[]
  learningMaterials LearningMaterial[]
  materialLinks  MaterialClass[]
  messages       Message[]
}

model ClassStudentList {
  id           String   @id @default(cuid())
  classId      String
  orgDefinedId String   // stored WITHOUT "#" prefix, e.g. "811947904"
  firstName    String
  lastName     String
  email        String   @default("") // student email — required for teacher→student notifications (default "" keeps db push safe on existing rows)
  isRegistered Boolean  @default(false)
  createdAt    DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, orgDefinedId])
  @@index([orgDefinedId])
}

model ClassEnrollment {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  joinedAt  DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  // Student "my classes" list: WHERE studentId ORDER BY joinedAt DESC
  @@index([studentId, joinedAt])
}

model Invitation {
  id        String    @id @default(cuid())
  classId   String
  token     String    @unique @default(cuid())
  expiresAt DateTime?
  maxUses   Int?
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

// ─── Content ──────────────────────────────────────────────────────────────────
// Ownership convention: teacherId = NULL means the row lives in the GLOBAL POOL
// (admin-managed); a non-null teacherId means it is private to that teacher.
// Promote (admin) and import (teacher) both deep-copy, so pool and teacher
// content never affect each other.
// Physical table/column names are pinned with @map — deploys apply the schema
// with `prisma db push`, and a real rename would drop the data.

model Topic {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  teacherId String?  @map("createdById")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher? @relation("TeacherTopics", fields: [teacherId], references: [id], onDelete: Cascade)
  quizzes Quiz[]

  @@index([teacherId])
}

// A quiz (formerly "Subtopic" / "Module") is the unit students take: a named,
// owned set of questions. topicId is an optional grouping label only —
// deleting a topic detaches its quizzes, never deletes them.
model Quiz {
  id           String   @id @default(cuid())
  name         String
  order        Int      @default(0)
  topicId      String?
  teacherId    String?  @map("createdById")
  sourceQuizId String? // lineage: the pool quiz this was imported from, or the teacher quiz a pool copy was promoted from
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  topic          Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  teacher        Teacher?            @relation("TeacherQuizzes", fields: [teacherId], references: [id], onDelete: Cascade)
  questions      Question[]
  quizProgress   QuizProgress[]
  quizAttempts   QuizAttempt[]
  imports        QuestionImport[]
  classQuizzes   ClassQuiz[]
  pdfExtractions QuizPdfExtraction[]

  @@index([topicId])
  @@index([teacherId])
  @@map("Subtopic")
}

// difficultyLevel: "BEGINNER" | "INTERMEDIATE" | "ADVANCED"
// answerMode: "SINGLE_SELECT" | "MULTI_SELECT" | "NUMERIC"
// True/false questions are SINGLE_SELECT with two options ("True"/"False").
model Question {
  id                String   @id @default(cuid())
  title             String?
  text              String
  quizId            String   @map("subtopicId")
  difficultyLevel   String   @default("BEGINNER")
  answerMode        String   @default("SINGLE_SELECT")
  points            Int?
  feedbackGeneral   String?
  feedbackCorrect   String?
  feedbackIncorrect String?
  sourceQuestionId  String?
  importId          String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // NUMERIC questions only; null for choice questions. Grading accepts
  // |submitted - answerNumeric| <= (answerTolerance ?? max(0.01, 0.005*|answerNumeric|)).
  answerNumeric   Float?
  answerTolerance Float? // absolute ±; null = default policy above
  answerUnit      String? // display-only unit suffix (may contain LaTeX), never graded

  // Optional figure the question depends on (cropped from a quiz PDF page).
  figureStorageKey String?
  figureBucket     String?
  figureAlt        String?

  quiz        Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdBy   Teacher?        @relation("TeacherQuestions", fields: [createdById], references: [id], onDelete: SetNull)
  import      QuestionImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  options     Option[]
  quizAnswers QuizAnswer[]
  simulation  QuestionSimulation?

  @@index([importId])
  // Quiz generation: WHERE quizId ORDER BY createdAt ASC
  @@index([quizId, createdAt])
  @@index([createdById])
}

// status: "COMPLETED" | "FAILED"
// teacherId is NULL when an admin imported straight into the global pool.
model QuestionImport {
  id            String   @id @default(cuid())
  teacherId     String?
  quizId        String   @map("subtopicId")
  originalName  String
  sourcePath    String?
  bankId        String?
  bankTitle     String?
  status        String   @default("COMPLETED")
  importedCount Int      @default(0)
  skippedCount  Int      @default(0)
  errorCount    Int      @default(0)
  errors        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher       Teacher?           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  quiz          Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questions     Question[]
  pdfExtraction QuizPdfExtraction?

  @@index([teacherId])
  @@index([quizId])
}

// ─── PDF Quiz Extraction (vision-LLM import pipeline) ─────────────────────────
// status: "PENDING_UPLOAD" | "EXTRACTING" | "AWAITING_REVIEW" | "COMMITTED" | "FAILED"
// teacherId is NULL when an admin extracts into a global-pool quiz.
// extractedQuestions holds the staged StagedQuestion[] JSON awaiting teacher
// review; on commit a QuestionImport row is created and linked so committed
// questions share the same provenance system as QTI imports.
model QuizPdfExtraction {
  id                 String   @id @default(cuid())
  quizId             String   @map("subtopicId")
  teacherId          String?
  originalName       String
  sizeBytes          Int
  storageKey         String // original PDF
  bucket             String
  status             String   @default("PENDING_UPLOAD")
  totalPages         Int      @default(0)
  errorMessage       String?
  hasAnswerKey       Boolean? // detected by the model; null until extracted
  extractedQuestions String? // JSON: StagedQuestion[]
  warnings           String   @default("[]") // JSON string[]
  questionImportId   String?  @unique // set on commit

  // AI generation metrics from the extraction run (all passes aggregated).
  // Shown to teachers/admins on the review screen; null until extracted.
  aiModel  String?
  aiTtftMs Int?
  aiTokens Int?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  quiz    Quiz                    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  teacher Teacher?                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  import  QuestionImport?         @relation(fields: [questionImportId], references: [id], onDelete: SetNull)
  pages   QuizPdfExtractionPage[]

  @@index([quizId])
  @@index([teacherId])
}

model QuizPdfExtractionPage {
  id           String @id @default(cuid())
  extractionId String
  pageNumber   Int
  storageKey   String // rasterized page PNG in S3

  extraction QuizPdfExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  @@unique([extractionId, pageNumber])
  @@index([extractionId])
}

model Option {
  id         String  @id @default(cuid())
  text       String
  isCorrect  Boolean @default(false)
  questionId String

  // Optional image choice (cropped from a quiz PDF page, like a question figure).
  // An image option stores text = "" (never null) so every option.text reader is
  // safe; imageAlt holds a short label/caption used as alt text.
  imageStorageKey String?
  imageBucket     String?
  imageAlt        String?

  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quizAnswers QuizAnswer[]

  // Loaded on every quiz fetch (include: { options }) and bulk-replaced on
  // question edit (deleteMany({ questionId })) — SQLite does not index FKs.
  @@index([questionId])
}

// ─── Class <-> Quiz (with publish control) ────────────────────────────────────

model ClassQuiz {
  id        String  @id @default(cuid())
  classId   String
  quizId    String
  published Boolean @default(false)

  // Per-class quiz availability + attempt controls. All nullable: existing rows
  // default to null = always open / unlimited attempts (no backfill needed).
  availableFrom  DateTime? // quiz opens (null = always open)
  availableUntil DateTime? // quiz closes (null = never closes)
  maxAttempts    Int? // total completed attempts allowed (null/0 = unlimited)

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  quiz  Quiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([classId, quizId])
  @@index([quizId])
}

// ─── Learning Progress ────────────────────────────────────────────────────────
// status: "NOT_STARTED" | "IN_PROGRESS" | "COMPLETED"

model QuizProgress {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  quizId    String   @map("subtopicId")
  status    String   @default("NOT_STARTED")
  bestScore Float?
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, quizId])
  @@index([classId])
  @@index([quizId])
  @@map("ModuleProgress")
}

model QuizAttempt {
  id          String    @id @default(cuid())
  studentId   String
  classId     String
  quizId      String?   @map("subtopicId")
  score       Float?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  // SetNull (not Cascade): deleting a quiz — e.g. an admin pruning the global
  // pool — must never erase students' attempt history.
  quiz    Quiz?        @relation(fields: [quizId], references: [id], onDelete: SetNull)
  answers QuizAnswer[]

  // Latest-completed-attempt lookups: WHERE studentId AND completedAt IS NOT
  // NULL ORDER BY completedAt DESC (also serves plain studentId filters)
  @@index([studentId, completedAt])
  @@index([classId])
  @@index([quizId])
}

model QuizAnswer {
  id                String   @id @default(cuid())
  quizAttemptId     String
  questionId        String
  selectedOptionId  String?
  selectedOptionIds String   @default("[]")
  numericValue      Float? // student's response to a NUMERIC question; null otherwise
  isCorrect         Boolean  @default(false)

  quizAttempt    QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option?     @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([quizAttemptId])
  // FK cascade/SetNull targets — question delete and option delete (bulk
  // option replacement on question edit) scan this table without these.
  @@index([questionId])
  @@index([selectedOptionId])
}

// ─── Exam Results (durable archival snapshot) ─────────────────────────────────
// Deliberately RELATION-FREE: it stores plain id columns (no @relation), so no
// cascade can delete it when a Student/Class/Quiz/Question/QuizAttempt is
// removed, and a full self-contained snapshot of everything needed to render the
// results, so teacher edits/deletions of quiz questions never alter a past
// result. AI fields are populated asynchronously by the background worker.
// summaryStatus / recommendationsStatus: "PENDING" | "GENERATING" | "READY" | "FAILED"
model ExamResult {
  id            String @id @default(cuid())
  quizAttemptId String @unique
  studentId     String
  classId       String
  quizId        String @map("subtopicId")

  // identity snapshot — survives rename/deletion of the live rows
  studentName String?
  className   String
  topicName   String
  quizName    String @map("subtopicName")

  // score snapshot
  score        Float
  correctCount Int
  totalCount   Int
  completedAt  DateTime

  // self-contained per-question review snapshot (JSON string)
  reviewSnapshot String

  // AI content + independent generation status
  summary               String?
  summaryStatus         String  @default("PENDING")
  recommendations       String? // JSON: { items: StoredRecommendation[], truncated: boolean }
  recommendationsStatus String  @default("PENDING")

  // AI generation metrics (TTFT + generated tokens) for each section. Persisted
  // for observability; the student results page does not display them.
  aiModel       String?
  summaryTtftMs Int?
  summaryTokens Int?
  recsTtftMs    Int?
  recsTokens    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, completedAt])
  @@index([classId])
}

// ─── AI Provider Configuration ────────────────────────────────────────────────
// providerType: "openai" | "local" | "cloudflare"

model AiProvider {
  id           String   @id @default(cuid())
  name         String                // human label, e.g. "Production OpenAI"
  providerType String                // "openai" | "local" | "cloudflare"
  baseUrl      String?               // null for OpenAI (uses default); URL for local or Cloudflare AI Gateway
  apiKeyEnc    String?               // AES-256-GCM encrypted bearer token (OpenAI key, or CF_AIG_TOKEN for cloudflare)
  apiKeyIv     String?
  apiKeyTag    String?

  // Cloudflare AI Gateway — only used when providerType = "cloudflare"
  cfAigByokAlias String?             // optional BYOK alias (sent as cf-aig-byok-alias header)

  // Per-request timeout (ms) applied to every AI call made with this provider.
  // null → fall back to DEFAULT_AI_TIMEOUT_MS (see src/lib/ai-provider.ts).
  timeoutMs    Int?

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  models      AiModel[]
  assignments AiUseCaseAssignment[]
}

model AiModel {
  id          String   @id @default(cuid())
  providerId  String
  modelId     String                // e.g. "gpt-5.1", "llama-3.3-70b"
  displayName String?               // optional friendly name
  serviceTier String?               // "flex" | "auto" | "default" | null
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  provider    AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  assignments AiUseCaseAssignment[]

  @@unique([providerId, modelId, serviceTier])
  @@index([providerId])
}

// useCase: "teacher_chat" | "student_chat" | "pdf_description" | "quiz_extraction" | "simulation_generation"
model AiUseCaseAssignment {
  id         String   @id @default(cuid())
  useCase    String   @unique       // only one assignment per use case
  providerId String
  modelId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  model    AiModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

// ─── Email / Notifications ─────────────────────────────────────────────────────
// Singleton SMTP server configuration, managed by admins. The SMTP password is
// encrypted at rest with AES-256-GCM (see src/lib/crypto.ts), mirroring the way
// AI provider API keys are stored.
model SmtpConfig {
  id          String  @id @default("singleton") // enforce a single row
  host        String
  port        Int     @default(465)
  secure      Boolean @default(true)            // true = implicit TLS (port 465); derived from port in the admin UI

  username    String?                            // SMTP auth username (often the from address)
  passwordEnc String?                            // AES-256-GCM encrypted SMTP password
  passwordIv  String?
  passwordTag String?

  fromEmail   String                             // envelope/from address
  fromName    String?                            // optional display name

  isActive    Boolean  @default(false)           // email sending only enabled when true
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Database backups ──────────────────────────────────────────────────────────
// Singleton WebDAV backup configuration, managed by admins. The WebDAV password
// is encrypted at rest with AES-256-GCM (see src/lib/crypto.ts), mirroring
// SmtpConfig. Snapshots are pushed to `<baseDir>/<env>/` (prod|dev) by the
// worker, and the admin "Restore" flow stages any of them for the next boot.
model BackupConfig {
  id String @id @default("singleton")

  webdavUrl      String?
  webdavUsername String?
  passwordEnc    String? // AES-256-GCM encrypted WebDAV password
  passwordIv     String?
  passwordTag    String?
  baseDir        String  @default("/backups")

  enabled       Boolean @default(false)
  intervalHours Int     @default(24)
  anchorTime    String  @default("02:00") // HH:mm interpreted in `timezone`
  timezone      String  @default("America/New_York")

  // Grandfather-father-son retention — how many to keep in each tier.
  keepRecent  Int @default(7)
  keepWeekly  Int @default(4)
  keepMonthly Int @default(12)
  keepYearly  Int @default(3)

  // Status of the most recent run (surfaced in the admin UI).
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  lastStatus    String? // "SUCCESS" | "FAILED" | "RUNNING"
  lastError     String?
  lastBackupKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A message either broadcast from a teacher to the students on a class roster,
// or sent from a single student to their teacher. Persisted for an audit trail
// regardless of delivery outcome — and, for the in-app channel, the source row
// the per-recipient Notification rows point back to for subject/body.
// direction: "TEACHER_TO_STUDENTS" | "STUDENT_TO_TEACHER"
// channels:  comma-joined of "IN_APP" | "EMAIL" (e.g. "IN_APP,EMAIL"). The
//            recipientCount/sentCount/status/error fields below describe the
//            EMAIL send only; inAppCount is the number of in-app recipients.
// status:    "SENT" | "PARTIAL" | "FAILED" (email outcome; "SENT" when no email)
model Message {
  id             String   @id @default(cuid())
  classId        String?
  direction      String
  channels       String   @default("EMAIL") // existing rows predate in-app, so default to email
  senderUserId   String
  subject        String
  body           String
  recipientCount Int      @default(0) // email recipients attempted
  sentCount      Int      @default(0) // email recipients delivered
  inAppCount     Int      @default(0) // in-app notification recipients
  status         String   @default("SENT")
  error          String?
  createdAt      DateTime @default(now())

  class         Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  sender        User           @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([classId])
  @@index([senderUserId])
  @@index([direction])
  // Email quota: WHERE senderUserId AND channels LIKE '%EMAIL%' AND createdAt >= window
  @@index([senderUserId, createdAt])
}

// One in-app notification delivered to a single student (their User). The
// subject/body live on the parent Message; this row carries per-recipient read
// state and powers the student mailbox.
model Notification {
  id        String    @id @default(cuid())
  messageId String
  userId    String // recipient student's user id
  readAt    DateTime?
  createdAt DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  // Mailbox list + unread badge: WHERE userId ORDER BY createdAt DESC; unread count
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([messageId])
}

// ─── Concept & Misconception catalog ──────────────────────────────────────────
// Admin-managed reference catalog imported from spreadsheet exports (see
// src/lib/concept-csv.ts). Deliberately no FK/relation onto Question or
// LearningMaterial yet — concept↔question / concept↔material tagging is out of
// scope for this slice.

model Concept {
  id              String   @id @default(cuid())
  conceptId       String   @unique          // "F-FV-1", "AP-2.2.A"
  kind            String                    // detailed_lo | ap_lo | ap_lo_child
  parentApLo      String?                   // parent conceptId as plain string (no FK; parents may be deprecated)
  unit            String?
  topic           String?
  displayName     String
  description     String?
  sourceLoCode    String?
  comments        String?
  notes           String?
  url             String?
  deprecated      Boolean  @default(false)
  deprecationNote String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  misconceptionLinks ConceptMisconception[]

  @@index([deprecated])
}

model Misconception {
  id              String   @id @default(cuid())
  misconceptionId String   @unique          // "MIS-001"
  statement       String
  sourceCitation  String?
  link            String?
  sourceType      String?
  notes           String?
  deprecated      Boolean  @default(false)
  deprecationNote String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conceptLinks ConceptMisconception[]

  @@index([deprecated])
}

model ConceptMisconception {
  id              String   @id @default(cuid())
  misconceptionId String
  conceptId       String
  confidence      String?  // High | Medium | Low
  notes           String?
  createdAt       DateTime @default(now())

  misconception Misconception @relation(fields: [misconceptionId], references: [misconceptionId], onDelete: Cascade)
  concept       Concept       @relation(fields: [conceptId], references: [conceptId], onDelete: Cascade)

  @@unique([misconceptionId, conceptId])
}

model ConceptExternalRef {
  id        String   @id @default(cuid())
  conceptId String                          // plain string, soft reference
  refCode   String                          // "F-FF-1.M1", "MC-LIU-20"
  refType   String                          // heuristic | primary
  sourceUrl String?
  createdAt DateTime @default(now())

  @@unique([conceptId, refCode, refType])
}

// ─── Question simulations (AI-generated interactive HTML) ─────────────────────
// One optional simulation per question: a self-contained HTML/JS page teaching
// the question's BROAD topic (never the question's numbers, scenario, or
// answer — it is shown to students post-quiz while results are still blind).
// The artifact lives in S3; every (re)generation writes a NEW versioned key and
// old objects are never deleted, because deep-copied questions share keys the
// same way figures do (see deepCopyQuiz).
// status: "PENDING"   queued/in-flight first generation (no artifact yet)
//         "REVISING"  queued/in-flight feedback revision (old artifact stays visible)
//         "READY" | "DECLINED" | "FAILED" terminal until re-triggered
model QuestionSimulation {
  id         String @id @default(cuid())
  questionId String @unique
  status     String @default("PENDING")

  // What the simulation teaches — broad topic only, set by the triage call.
  topic        String?
  title        String?
  learningGoal String?

  // Triage's stated reason when it declines (helpful=false); shown to staff.
  declineReason String?
  errorMessage  String?

  // Current HTML artifact. null until first READY. version counts uploads.
  storageKey String?
  bucket     String?
  version    Int     @default(0)

  // Build spec (plain text) produced by triage; revisions are generated from
  // this spec + feedback, never from the raw question (leakage firewall).
  simSpec String?

  sourceSimulationId String? // lineage: the sim this row was deep-copied from (plain id, no FK)

  // AI generation metrics, aggregated across the job's calls.
  aiModel  String?
  aiTtftMs Int?
  aiTokens Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  feedback SimulationFeedback[]

  @@index([status])
}

// One teacher/admin correction round on a simulation ("the period formula is
// wrong", "sliders overflow"). Each row drives one revision job.
// status: "PENDING" | "APPLIED" | "FAILED"
model SimulationFeedback {
  id           String @id @default(cuid())
  simulationId String
  authorUserId String // plain User id (no FK; feedback must survive account deletion)
  authorName   String?
  feedback     String
  status       String @default("PENDING")
  errorMessage String?

  // The storageKey the simulation had when this feedback was applied, kept so
  // staff can compare versions.
  previousStorageKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  simulation QuestionSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId, createdAt])
}
