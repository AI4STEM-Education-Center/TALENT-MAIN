generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Users ────────────────────────────────────────────────────────────────────
// role: "TEACHER" | "STUDENT"

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  username       String   @unique
  hashedPassword String
  firstName      String
  lastName       String
  role           String   @default("STUDENT")
  createdAt      DateTime @default(now())

  teacher Teacher?
  student Student?

  sentMessages Message[] @relation("MessageSender")

  @@index([role])
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  classes           Class[]
  topics            Topic[]             @relation("TeacherTopics")
  quizzes           Quiz[]              @relation("TeacherQuizzes")
  questions         Question[]          @relation("TeacherQuestions")
  questionImports   QuestionImport[]
  learningMaterials LearningMaterial[]
  pdfExtractions    QuizPdfExtraction[]
}

// Uploaded learning materials (S3 only). uploadStatus: "PENDING" | "READY" | "FAILED"
model LearningMaterial {
  id           String  @id @default(cuid())
  teacherId    String
  classId      String?
  title        String?
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  bucket       String
  uploadStatus String  @default("PENDING")
  processingStatus String @default("IDLE")
  folder       String?
  totalPages     Int     @default(0)
  processedPages Int     @default(0)
  errorMessage   String?
  batchDescription  String?
  batchKeyConcepts  String  @default("[]")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  pages   MaterialPage[]
  classLinks MaterialClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([classId])
}

// Junction: a material can be shared across multiple of a teacher's classes.
model MaterialClass {
  id         String   @id @default(cuid())
  materialId String
  classId    String
  createdAt  DateTime @default(now())

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  class    Class            @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([materialId, classId])
  @@index([classId])
  @@index([materialId])
}

model MaterialPage {
  id           String  @id @default(cuid())
  materialId   String
  pageNumber   Int
  storageKey   String

  // Tier 1 VLM results (null = not yet processed)
  needed       Boolean?
  keyConcept   String?
  description  String?

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([materialId, pageNumber])
  @@index([materialId])
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enrollments  ClassEnrollment[]
  quizProgress QuizProgress[]
  quizAttempts QuizAttempt[]
}

// ─── Classes ──────────────────────────────────────────────────────────────────

model Class {
  id          String   @id @default(cuid())
  name        String
  description String?
  teacherId   String
  createdAt   DateTime @default(now())

  teacher        Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments    ClassEnrollment[]
  invitations    Invitation[]
  classQuizzes   ClassQuiz[]
  quizProgress   QuizProgress[]
  quizAttempts   QuizAttempt[]
  studentList    ClassStudentList[]
  learningMaterials LearningMaterial[]
  materialLinks  MaterialClass[]
  messages       Message[]
}

model ClassStudentList {
  id           String   @id @default(cuid())
  classId      String
  orgDefinedId String   // stored WITHOUT "#" prefix, e.g. "811947904"
  firstName    String
  lastName     String
  email        String   @default("") // student email — required for teacher→student notifications (default "" keeps db push safe on existing rows)
  isRegistered Boolean  @default(false)
  createdAt    DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, orgDefinedId])
  @@index([orgDefinedId])
}

model ClassEnrollment {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  joinedAt  DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  // Student "my classes" list: WHERE studentId ORDER BY joinedAt DESC
  @@index([studentId, joinedAt])
}

model Invitation {
  id        String    @id @default(cuid())
  classId   String
  token     String    @unique @default(cuid())
  expiresAt DateTime?
  maxUses   Int?
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

// ─── Content ──────────────────────────────────────────────────────────────────
// Ownership convention: teacherId = NULL means the row lives in the GLOBAL POOL
// (admin-managed); a non-null teacherId means it is private to that teacher.
// Promote (admin) and import (teacher) both deep-copy, so pool and teacher
// content never affect each other.
// Physical table/column names are pinned with @map — deploys apply the schema
// with `prisma db push`, and a real rename would drop the data.

model Topic {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  teacherId String?  @map("createdById")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher? @relation("TeacherTopics", fields: [teacherId], references: [id], onDelete: Cascade)
  quizzes Quiz[]

  @@index([teacherId])
}

// A quiz (formerly "Subtopic" / "Module") is the unit students take: a named,
// owned set of questions. topicId is an optional grouping label only —
// deleting a topic detaches its quizzes, never deletes them.
model Quiz {
  id           String   @id @default(cuid())
  name         String
  order        Int      @default(0)
  topicId      String?
  teacherId    String?  @map("createdById")
  sourceQuizId String? // lineage: the pool quiz this was imported from, or the teacher quiz a pool copy was promoted from
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  topic          Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  teacher        Teacher?            @relation("TeacherQuizzes", fields: [teacherId], references: [id], onDelete: Cascade)
  questions      Question[]
  quizProgress   QuizProgress[]
  quizAttempts   QuizAttempt[]
  imports        QuestionImport[]
  classQuizzes   ClassQuiz[]
  pdfExtractions QuizPdfExtraction[]

  @@index([topicId])
  @@index([teacherId])
  @@map("Subtopic")
}

// difficultyLevel: "BEGINNER" | "INTERMEDIATE" | "ADVANCED"
// answerMode: "SINGLE_SELECT" | "MULTI_SELECT" | "NUMERIC"
// True/false questions are SINGLE_SELECT with two options ("True"/"False").
model Question {
  id                String   @id @default(cuid())
  title             String?
  text              String
  quizId            String   @map("subtopicId")
  difficultyLevel   String   @default("BEGINNER")
  answerMode        String   @default("SINGLE_SELECT")
  points            Int?
  feedbackGeneral   String?
  feedbackCorrect   String?
  feedbackIncorrect String?
  sourceQuestionId  String?
  importId          String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // NUMERIC questions only; null for choice questions. Grading accepts
  // |submitted - answerNumeric| <= (answerTolerance ?? max(0.01, 0.005*|answerNumeric|)).
  answerNumeric   Float?
  answerTolerance Float? // absolute ±; null = default policy above
  answerUnit      String? // display-only unit suffix (may contain LaTeX), never graded

  // Optional figure the question depends on (cropped from a quiz PDF page).
  figureStorageKey String?
  figureBucket     String?
  figureAlt        String?

  quiz        Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdBy   Teacher?        @relation("TeacherQuestions", fields: [createdById], references: [id], onDelete: SetNull)
  import      QuestionImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  options     Option[]
  quizAnswers QuizAnswer[]

  @@index([importId])
  // Quiz generation: WHERE quizId ORDER BY createdAt ASC
  @@index([quizId, createdAt])
  @@index([createdById])
}

// status: "COMPLETED" | "FAILED"
// teacherId is NULL when an admin imported straight into the global pool.
model QuestionImport {
  id            String   @id @default(cuid())
  teacherId     String?
  quizId        String   @map("subtopicId")
  originalName  String
  sourcePath    String?
  bankId        String?
  bankTitle     String?
  status        String   @default("COMPLETED")
  importedCount Int      @default(0)
  skippedCount  Int      @default(0)
  errorCount    Int      @default(0)
  errors        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher       Teacher?           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  quiz          Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questions     Question[]
  pdfExtraction QuizPdfExtraction?

  @@index([teacherId])
  @@index([quizId])
}

// ─── PDF Quiz Extraction (vision-LLM import pipeline) ─────────────────────────
// status: "PENDING_UPLOAD" | "EXTRACTING" | "AWAITING_REVIEW" | "COMMITTED" | "FAILED"
// teacherId is NULL when an admin extracts into a global-pool quiz.
// extractedQuestions holds the staged StagedQuestion[] JSON awaiting teacher
// review; on commit a QuestionImport row is created and linked so committed
// questions share the same provenance system as QTI imports.
model QuizPdfExtraction {
  id                 String   @id @default(cuid())
  quizId             String   @map("subtopicId")
  teacherId          String?
  originalName       String
  sizeBytes          Int
  storageKey         String // original PDF
  bucket             String
  status             String   @default("PENDING_UPLOAD")
  totalPages         Int      @default(0)
  errorMessage       String?
  hasAnswerKey       Boolean? // detected by the model; null until extracted
  extractedQuestions String? // JSON: StagedQuestion[]
  warnings           String   @default("[]") // JSON string[]
  questionImportId   String?  @unique // set on commit
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  quiz    Quiz                    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  teacher Teacher?                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  import  QuestionImport?         @relation(fields: [questionImportId], references: [id], onDelete: SetNull)
  pages   QuizPdfExtractionPage[]

  @@index([quizId])
  @@index([teacherId])
}

model QuizPdfExtractionPage {
  id           String @id @default(cuid())
  extractionId String
  pageNumber   Int
  storageKey   String // rasterized page PNG in S3

  extraction QuizPdfExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  @@unique([extractionId, pageNumber])
  @@index([extractionId])
}

model Option {
  id         String  @id @default(cuid())
  text       String
  isCorrect  Boolean @default(false)
  questionId String

  // Optional image choice (cropped from a quiz PDF page, like a question figure).
  // An image option stores text = "" (never null) so every option.text reader is
  // safe; imageAlt holds a short label/caption used as alt text.
  imageStorageKey String?
  imageBucket     String?
  imageAlt        String?

  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quizAnswers QuizAnswer[]

  // Loaded on every quiz fetch (include: { options }) and bulk-replaced on
  // question edit (deleteMany({ questionId })) — SQLite does not index FKs.
  @@index([questionId])
}

// ─── Class <-> Quiz (with publish control) ────────────────────────────────────

model ClassQuiz {
  id        String  @id @default(cuid())
  classId   String
  quizId    String
  published Boolean @default(false)

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  quiz  Quiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([classId, quizId])
  @@index([quizId])
}

// ─── Learning Progress ────────────────────────────────────────────────────────
// status: "NOT_STARTED" | "IN_PROGRESS" | "COMPLETED"

model QuizProgress {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  quizId    String   @map("subtopicId")
  status    String   @default("NOT_STARTED")
  bestScore Float?
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, quizId])
  @@index([classId])
  @@index([quizId])
  @@map("ModuleProgress")
}

model QuizAttempt {
  id          String    @id @default(cuid())
  studentId   String
  classId     String
  quizId      String?   @map("subtopicId")
  score       Float?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  // SetNull (not Cascade): deleting a quiz — e.g. an admin pruning the global
  // pool — must never erase students' attempt history.
  quiz    Quiz?        @relation(fields: [quizId], references: [id], onDelete: SetNull)
  answers QuizAnswer[]

  // Latest-completed-attempt lookups: WHERE studentId AND completedAt IS NOT
  // NULL ORDER BY completedAt DESC (also serves plain studentId filters)
  @@index([studentId, completedAt])
  @@index([classId])
  @@index([quizId])
}

model QuizAnswer {
  id                String   @id @default(cuid())
  quizAttemptId     String
  questionId        String
  selectedOptionId  String?
  selectedOptionIds String   @default("[]")
  numericValue      Float? // student's response to a NUMERIC question; null otherwise
  isCorrect         Boolean  @default(false)

  quizAttempt    QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option?     @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([quizAttemptId])
  // FK cascade/SetNull targets — question delete and option delete (bulk
  // option replacement on question edit) scan this table without these.
  @@index([questionId])
  @@index([selectedOptionId])
}

// ─── Exam Results (durable archival snapshot) ─────────────────────────────────
// Deliberately RELATION-FREE: it stores plain id columns (no @relation), so no
// cascade can delete it when a Student/Class/Quiz/Question/QuizAttempt is
// removed, and a full self-contained snapshot of everything needed to render the
// results, so teacher edits/deletions of quiz questions never alter a past
// result. AI fields are populated asynchronously by the background worker.
// summaryStatus / recommendationsStatus: "PENDING" | "GENERATING" | "READY" | "FAILED"
model ExamResult {
  id            String @id @default(cuid())
  quizAttemptId String @unique
  studentId     String
  classId       String
  quizId        String @map("subtopicId")

  // identity snapshot — survives rename/deletion of the live rows
  studentName String?
  className   String
  topicName   String
  quizName    String @map("subtopicName")

  // score snapshot
  score        Float
  correctCount Int
  totalCount   Int
  completedAt  DateTime

  // self-contained per-question review snapshot (JSON string)
  reviewSnapshot String

  // AI content + independent generation status
  summary               String?
  summaryStatus         String  @default("PENDING")
  recommendations       String? // JSON: { items: StoredRecommendation[], truncated: boolean }
  recommendationsStatus String  @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, completedAt])
  @@index([classId])
}

// ─── AI Provider Configuration ────────────────────────────────────────────────
// providerType: "openai" | "local" | "cloudflare"

model AiProvider {
  id           String   @id @default(cuid())
  name         String                // human label, e.g. "Production OpenAI"
  providerType String                // "openai" | "local" | "cloudflare"
  baseUrl      String?               // null for OpenAI (uses default); URL for local or Cloudflare AI Gateway
  apiKeyEnc    String?               // AES-256-GCM encrypted bearer token (OpenAI key, or CF_AIG_TOKEN for cloudflare)
  apiKeyIv     String?
  apiKeyTag    String?

  // Cloudflare AI Gateway — only used when providerType = "cloudflare"
  cfAigByokAlias String?             // optional BYOK alias (sent as cf-aig-byok-alias header)

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  models      AiModel[]
  assignments AiUseCaseAssignment[]
}

model AiModel {
  id          String   @id @default(cuid())
  providerId  String
  modelId     String                // e.g. "gpt-5.1", "llama-3.3-70b"
  displayName String?               // optional friendly name
  serviceTier String?               // "flex" | "auto" | "default" | null
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  provider    AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  assignments AiUseCaseAssignment[]

  @@unique([providerId, modelId, serviceTier])
  @@index([providerId])
}

// useCase: "teacher_chat" | "student_chat" | "pdf_description" | "quiz_extraction"
model AiUseCaseAssignment {
  id         String   @id @default(cuid())
  useCase    String   @unique       // only one assignment per use case
  providerId String
  modelId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  model    AiModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

// ─── Email / Notifications ─────────────────────────────────────────────────────
// Singleton SMTP server configuration, managed by admins. The SMTP password is
// encrypted at rest with AES-256-GCM (see src/lib/crypto.ts), mirroring the way
// AI provider API keys are stored.
model SmtpConfig {
  id          String  @id @default("singleton") // enforce a single row
  host        String
  port        Int     @default(587)
  secure      Boolean @default(false)           // true = implicit TLS (port 465)

  username    String?                            // SMTP auth username (often the from address)
  passwordEnc String?                            // AES-256-GCM encrypted SMTP password
  passwordIv  String?
  passwordTag String?

  fromEmail   String                             // envelope/from address
  fromName    String?                            // optional display name

  isActive    Boolean  @default(false)           // email sending only enabled when true
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A message either broadcast from a teacher to the students on a class roster,
// or sent from a single student to their teacher. Persisted for an audit trail
// regardless of email delivery outcome.
// direction: "TEACHER_TO_STUDENTS" | "STUDENT_TO_TEACHER"
// status:    "SENT" | "PARTIAL" | "FAILED"
model Message {
  id             String   @id @default(cuid())
  classId        String?
  direction      String
  senderUserId   String
  subject        String
  body           String
  recipientCount Int      @default(0)
  sentCount      Int      @default(0)
  status         String   @default("SENT")
  error          String?
  createdAt      DateTime @default(now())

  class  Class? @relation(fields: [classId], references: [id], onDelete: SetNull)
  sender User   @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([senderUserId])
  @@index([direction])
}
