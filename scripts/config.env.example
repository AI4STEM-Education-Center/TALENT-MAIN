# ============================================================================
# One place to configure the whole deployment.
#
#   cp scripts/config.env.example scripts/config.env
#   $EDITOR scripts/config.env
#
# Every numbered script sources scripts/config.env and refuses to run if a
# value it needs is still empty. Nothing below is baked into a script body, so
# a new environment (different domain, different region, second box) is a copy
# of this file rather than an edit sweep.
#
# config.env holds real secrets. It is gitignored; the reusable scripts and
# this example stay tracked. Keep the real file mode 600 and never paste it
# into an issue or a chat.
#   chmod 600 scripts/config.env
# ============================================================================

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# Prefix for every AWS resource this creates (security group, IAM user, key
# pair, Name tags), so a stray resource is always traceable back to here.
PROJECT="talent"

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
# Named profile from ~/.aws/credentials. Leave empty to use the default chain.
AWS_PROFILE=""
AWS_REGION="us-east-1"

# ---------------------------------------------------------------------------
# EC2
# ---------------------------------------------------------------------------
EC2_INSTANCE_NAME="${PROJECT}-app"
# 2 vCPU / 2 GiB. The box runs prod web + worker, dev web + worker, Caddy and
# SQLite. t3.micro (1 GiB) will OOM during a PDF rasterization.
EC2_INSTANCE_TYPE="t3.small"
EC2_VOLUME_GB="30"
EC2_KEY_NAME="${PROJECT}-admin"
# Where the generated private key is written on your laptop.
EC2_KEY_FILE="${HOME}/.ssh/${PROJECT}-admin.pem"
# Login user of the AMI. Debian cloud images use "admin".
EC2_USER="admin"
# Debian 12 (bookworm). For Debian 13 use .../release/13/latest/amd64 — the
# script falls back to a describe-images lookup if the parameter is absent.
EC2_AMI_SSM_PARAM="/aws/service/debian/release/12/latest/amd64"

# Port 22 is reachable by GitHub-hosted Actions runners as well as admins.
# Their source ranges are large and change frequently, so step 02 hardens sshd
# to public-key-only authentication instead of maintaining a brittle IP list.

# ---------------------------------------------------------------------------
# Domains and Cloudflare
# ---------------------------------------------------------------------------
# The zone as it appears in the Cloudflare dashboard (no scheme, no trailing
# dot).
CF_ZONE="ai4talent.org"
PROD_HOST="ai4talent.org"
DEV_HOST="dev.ai4talent.org"

# One scoped token used by three things: Caddy's DNS-01 certificate challenge,
# the DDNS updater, and the CF IP-range refresher.
# Create at: https://dash.cloudflare.com/profile/api-tokens
#   Permissions: Zone -> DNS -> Edit
#                Zone -> Zone -> Read
#   Zone Resources: Include -> Specific zone -> $CF_ZONE
# A global API key also works but grants your entire account — don't.
CF_API_TOKEN=""

# Contact address Let's Encrypt uses for expiry warnings.
ACME_EMAIL=""

# ---------------------------------------------------------------------------
# S3 and CloudFront
# ---------------------------------------------------------------------------
# Must be globally unique. Avoid embedding the AWS account id — the old bucket
# name did, and a bucket name is visible in every presigned upload URL.
S3_BUCKET=""
# Least-privilege IAM user whose static keys the app uses. No instance role.
IAM_USER="${PROJECT}-app"
# Existing-deployment recovery only: AWS never reveals an access-key secret a
# second time. Copy both values from protected state/config if this IAM user
# already has a key. Leave empty on a genuinely new install; step 03 creates a
# least-privilege key and stores it in scripts/.state.env.
APP_AWS_ACCESS_KEY_ID=""
APP_AWS_SECRET_ACCESS_KEY=""
# Local path for the generated CloudFront signing key pair.
CLOUDFRONT_KEY_DIR="${HOME}/.talent-keys"

# ---------------------------------------------------------------------------
# Container registry
# ---------------------------------------------------------------------------
GHCR_IMAGE="ghcr.io/ai4stem-education-center/talent-main"
GHCR_USER=""
# Classic PAT with read:packages only. Used by the box to pull private images.
# NOT the token in the old ec2-setup.sh — that one is burned, revoke it.
GHCR_TOKEN=""

# ---------------------------------------------------------------------------
# Paths on the box
# ---------------------------------------------------------------------------
APP_DIR="/home/${EC2_USER}/app"
CADDY_DIR="/home/${EC2_USER}/caddy"

# ---------------------------------------------------------------------------
# Application secrets (written into $APP_DIR/.env by 04-app-env.sh)
# ---------------------------------------------------------------------------
# Leave empty only for a genuinely new installation. 04-app-env.sh generates a
# strong value and reuses it on re-runs. For a replacement-instance restore,
# copy these values from the previous deployment's securely stored config.env
# BEFORE running step 04. The restored database's AI provider, SMTP, and WebDAV
# secrets require its original API_KEY_ENCRYPTION_SECRET; the database backup
# cannot recover that key because it intentionally lives outside the database.
AUTH_SECRET=""
API_KEY_ENCRYPTION_SECRET=""
API_KEY_ENCRYPTION_SECRET_OLD=""

# Shared only with people who should be able to self-register at that level.
TEACHER_SIGNUP_TOKEN=""
ADMIN_SIGNUP_TOKEN=""
LEARNING_MATERIAL_MAX_BYTES="52428800"

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
# rclone remote for the nightly SQLite snapshot, e.g. "onedrive:/TalentBackups".
# Leave empty to skip installing the cron job. This is belt-and-braces next to
# the in-app WebDAV backup configured in the admin dashboard.
BACKUP_RCLONE_REMOTE=""
BACKUP_KEEP_DAYS="7"
