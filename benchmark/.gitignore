# Run artifacts. Every run writes a timestamped directory here; they are large
# (raw k6 JSON, container logs, metric series) and reproducible from the scenario
# plus the seed, so they are not worth versioning.
results/

# Committed baselines are the deliberate exception — see baseline/README.md.
!baseline/
!baseline/**

# The golden database and the compressed copy shipped to EC2. Regenerated by the
# seed on demand; deterministic, so nothing is lost by not tracking it.
docker/data/
*.db
*.db-wal
*.db-shm
*.db.gz

# Generated secrets for the local stack (run-local.sh writes this on first run).
# Never committed: a benchmark database should not be decryptable with a key that
# exists anywhere else.
docker/bench.env

# Bundled mock AI provider — built from mock-ai/server.ts by the runners.
mock-ai/dist/

# Ephemeral SSH keys created per EC2 run. provision.sh deletes them on teardown;
# this is the safety net for the case where it cannot.
*.pem
