FROM node:26-slim

RUN apt-get update && apt-get install -y --no-install-recommends openssl python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace

COPY package.json package-lock.json ./
RUN npm ci
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
COPY src/lib/db-url.ts src/lib/prisma.ts ./src/lib/
COPY benchmark/seed.ts benchmark/verify.ts ./benchmark/
RUN npx prisma generate

CMD ["sh", "-c", "npx prisma db push && npx tsx benchmark/seed.ts --out /artifacts/fixture.json"]
