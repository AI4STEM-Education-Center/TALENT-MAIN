# Copy to bench.env, or just run benchmark/run-local.sh — it generates the file
# with fresh random secrets on first use. bench.env is gitignored on purpose: a
# benchmark database should never be decryptable with a key that exists anywhere
# else, and least of all with production's.

# Session signing key for the benchmark stack.
#   openssl rand -hex 32
BENCH_AUTH_SECRET=""

# Encrypts the seeded AI-provider credential. Must be exactly 64 hex characters
# (32 bytes) — src/lib/crypto.ts rejects anything else with a clear error.
#   openssl rand -hex 32
BENCH_API_KEY_ENCRYPTION_SECRET=""

# ─── Optional: exercise the S3 material pipeline ─────────────────────────────
# Presigning itself is a local HMAC and needs no credentials, so the quiz journey
# runs fine without these. Set them only to benchmark uploads and the VLM
# material path. Use a throwaway bucket, or a lifecycle rule on the bench/ prefix
# — the harness writes under S3_KEY_PREFIX=bench/, which no deployment reads.
AWS_REGION=""
AWS_S3_BUCKET=""

# ─── Optional: mock AI provider behaviour ────────────────────────────────────
# Defaults model a small streaming model. Raise MOCK_AI_TTFT_MS to simulate a
# slower provider and watch the worker queue depth respond; the seeded
# AiProvider row sets a 30s per-request timeout, so keep the total under it.
MOCK_AI_TTFT_MS="400"
MOCK_AI_TOKEN_DELAY_MS="8"
MOCK_AI_TOKENS="180"
# Fraction of AI calls answered with a 503, for resilience runs. Deterministic
# (every Nth request), not random, so a run stays reproducible.
MOCK_AI_FAILURE_RATE="0"
