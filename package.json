{
  "name": "adaptive-learning-webapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "seed:prebuilt": "tsx prisma/seed-prebuilt.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "setup": "npm run db:push && npm run seed && npm run seed:demo",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "npm run db:push && next build && next start",
    "deploy:full": "npm run db:push && npm run seed && npm run seed:demo && next build && next start",
    "worker": "tsx src/worker.ts",
    "worker:build": "esbuild src/worker.ts --bundle --platform=node --target=node24 --outfile=dist/worker.js --external:@russellthehippo/honker-node --external:@prisma/client --external:@prisma/adapter-better-sqlite3 --external:better-sqlite3",
    "doctor": "npx react-doctor@latest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "overrides": {
    "undici": "^7.28.0",
    "picomatch": "^4.0.3",
    "@radix-ui/react-slot": "1.3.3",
    "postcss": "$postcss",
    "brace-expansion@^5.0.0": "^5.0.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "@hyzyla/pdfium": "^2.1.13",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@russellthehippo/honker-node": "^0.4.5",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "openai": "^6.48.0",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "webdav": "^5.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/katex": "^0.16.8",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25",
    "prisma": "^7.9.1",
    "react-doctor": "^0.9.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
