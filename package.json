{
  "name": "adaptive-learning-webapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "seed:prebuilt": "tsx prisma/seed-prebuilt.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "setup": "npm run db:push && npm run seed && npm run seed:demo",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "npm run db:push && next build && next start",
    "deploy:full": "npm run db:push && npm run seed && npm run seed:demo && next build && next start",
    "worker": "tsx src/worker.ts",
    "worker:build": "esbuild src/worker.ts --bundle --platform=node --target=node24 --outfile=dist/worker.js --external:@russellthehippo/honker-node --external:@prisma/client --external:@prisma/adapter-better-sqlite3 --external:better-sqlite3",
    "doctor": "npx react-doctor@latest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1065.0",
    "@aws-sdk/s3-request-presigner": "^3.1065.0",
    "@hyzyla/pdfium": "^2.1.13",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-toast": "^1.2.16",
    "@russellthehippo/honker-node": "^0.3.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^6.42.0",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "react-rnd": "^10.5.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "eslint": "^10",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "prisma": "^7.8.0",
    "react-doctor": "^0.5.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.6"
  }
}
