{
  "name": "adaptive-learning-webapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "seed:prebuilt": "tsx prisma/seed-prebuilt.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "seed:consent": "tsx prisma/seed-consent.ts",
    "setup": "npm run db:push && npm run seed && npm run seed:demo && npm run seed:consent",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "npm run db:push && npm run seed:consent && next build && next start",
    "deploy:full": "npm run db:push && npm run seed && npm run seed:demo && npm run seed:consent && next build && next start",
    "worker": "tsx src/worker.ts",
    "worker:build": "esbuild src/worker.ts --bundle --platform=node --target=node24 --outfile=dist/worker.js --external:@russellthehippo/honker-node --external:@prisma/client --external:@prisma/adapter-better-sqlite3 --external:better-sqlite3",
    "doctor": "npx react-doctor@latest",
    "format": "npx --yes prettier@3.9.6 --write \"src/**/*.{ts,tsx}\" \"prisma/**/*.ts\" \"test/**/*.ts\" \"*.{mjs,ts,json}\" \".prettierrc.json\"",
    "format:check": "npx --yes prettier@3.9.6 --check \"src/**/*.{ts,tsx}\" \"prisma/**/*.ts\" \"test/**/*.ts\" \"*.{mjs,ts,json}\" \".prettierrc.json\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:release": "vitest run --config vitest.release.config.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:api:critical": "TEST_PROFILE=critical node pressure/api-test.mjs",
    "test:api:full": "TEST_PROFILE=full node pressure/api-test.mjs",
    "pressure": "pressure/run.sh",
    "pressure:report": "tsx pressure/collect/summarize.ts"
  },
  "overrides": {
    "undici": "^7.29.0",
    "picomatch": "^4.0.3",
    "@radix-ui/react-slot": "1.3.3",
    "postcss": "$postcss",
    "fast-uri": "^3.1.7",
    "brace-expansion@^1.0.0": "^1.1.18",
    "brace-expansion@^2.0.0": "^2.1.4",
    "brace-expansion@^5.0.0": "^5.0.9",
    "js-yaml@^4.0.0": "^4.3.1",
    "@babel/core@^7.0.0": "^7.29.6",
    "esbuild": "$esbuild"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/cloudfront-signer": "^3.1116.0",
    "@aws-sdk/lib-storage": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@hyzyla/pdfium": "^2.1.13",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@russellthehippo/honker-node": "^0.5.1",
    "@types/nodemailer": "^8.0.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.5",
    "lucide-react": "^1.38.0",
    "next": "^16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.0",
    "openai": "^7.8.0",
    "pdf-lib": "^1.17.1",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.7",
    "signature_pad": "^5.1.4",
    "tailwind-merge": "^3.6.0",
    "webdav": "^5.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prisma": "^7.10.0",
    "react-doctor": "^0.9.12",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "better-sqlite3@12.11.1": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver": true
  }
}
