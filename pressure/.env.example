# Current production EC2 host configuration (verified 2026-09-03).
AWS_PROFILE="default"
AWS_REGION="us-east-1"
EC2_SOURCE_INSTANCE_ID="i-003d570c5c6b7f8bc"
EC2_KEY_NAME="talent-admin"
EC2_SSH_KEY_PATH="/Users/edward/.ssh/talent-admin.pem"

# Keep the SUT type blank to clone the production instance type (currently
# t3a.large). The load generator is intentionally a separate, larger instance.
EC2_SUT_TYPE=""
EC2_LOADGEN_TYPE="c7i.2xlarge"
PRESSURE_SCENARIO="exam-day"
PRESSURE_SCALE="1"
PRESSURE_COHORT="120"
PRESSURE_DEADMAN_MINUTES="180"

# Required acknowledgement: the temporary SUT contains a production-volume
# snapshot until teardown. Sanitization prevents external effects but does not
# anonymize the records on that encrypted throwaway volume.
ACK_REAL_DATA=""

# Optional result publication. Configure both pairs to make the same result
# visible on the dev and production admin dashboards. Tokens must match the
# DEV_/PROD_PRESSURE_RESULTS_TOKEN values in ~/app/.env on the EC2 host.
DEV_RESULTS_URL="https://dev.ai4talent.org"
DEV_PRESSURE_RESULTS_TOKEN=""
PROD_RESULTS_URL="https://ai4talent.org"
PROD_PRESSURE_RESULTS_TOKEN=""
