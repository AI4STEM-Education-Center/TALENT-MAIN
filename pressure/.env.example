# Production EC2 host configuration. Fill these in with your own values;
# do not commit real instance IDs or key paths to pressure/.env.example.
AWS_PROFILE="default"
AWS_REGION="us-east-1"
EC2_SOURCE_INSTANCE_ID="i-xxxxxxxxxxxxxxxxx"
EC2_KEY_NAME="your-ec2-key-pair-name"
EC2_SSH_KEY_PATH="/path/to/your-ec2-key.pem"

# Leave EC2_SUT_TYPE blank to clone the production instance's own type.
# Set it only to deliberately test on a different SUT size, e.g. "t3a.large".
# The load generator is intentionally a separate, larger instance type.
EC2_SUT_TYPE=""
EC2_LOADGEN_TYPE="c7i.2xlarge"
PRESSURE_SCENARIO="exam-day"
PRESSURE_SCALE="1"
PRESSURE_COHORT="120"
PRESSURE_DEADMAN_MINUTES="180"

# Required acknowledgement: the temporary SUT contains a production-volume
# snapshot until teardown. Sanitization prevents external effects but does not
# anonymize the records on that encrypted throwaway volume. Read
# pressure/README.md, then set this to the literal string CLONE-PRODUCTION-DATA.
ACK_REAL_DATA=""

# Optional result publication. Configure both pairs to make the same result
# visible on the dev and production admin dashboards. Generate each token in
# that site's own Admin -> Pressure Tests page; nothing is set on the EC2 host.
DEV_RESULTS_URL="https://dev.ai4talent.org"
DEV_PRESSURE_RESULTS_TOKEN=""
PROD_RESULTS_URL="https://ai4talent.org"
PROD_PRESSURE_RESULTS_TOKEN=""
