# Database
# DATABASE_URL is used by Prisma directly (local dev).
# PROD_DATABASE_URL is mapped to DATABASE_URL by docker-compose for production.
# DEV_DATABASE_URL is mapped to DATABASE_URL by docker-compose for dev.
DATABASE_URL="file:./data/dev.db"
PROD_DATABASE_URL="file:./data/prod.db"
DEV_DATABASE_URL="file:./data/dev.db"
DB_PROVIDER="sqlite"

# Environment identity for database backups: "prod" | "dev" (defaults to "dev").
# docker-compose sets this per environment. Backups land in
# <WebDAV baseDir>/<APP_ENV>/.
APP_ENV="dev"

# Public base URL of this deployment, e.g. "https://dev.ai4talent.org". The
# worker has no incoming request to read a host from, so set this or the
# "you have a new message" emails can't link students to the message (they fall
# back to telling them to sign in). AUTH_URL / NEXTAUTH_URL are used if set.
APP_URL=""

# Auth
AUTH_SECRET="generate-a-random-secret-here"

# Public origin used to build links the app emails out (password reset).
# Optional: when unset the origin is derived from the request's proxy headers,
# which is correct for normal browser traffic. Set it if links must always
# point at one canonical host.
APP_BASE_URL=""

# Teacher signup restriction — share only with intended teachers
TEACHER_SIGNUP_TOKEN="your-secret-teacher-code"

# Admin signup restriction — share only with intended admins
ADMIN_SIGNUP_TOKEN="your-secret-admin-code"

# AI Provider Encryption Key (required)
# Used to encrypt API keys stored in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_SECRET=""

# Learning material uploads (S3 only). Use standard AWS env or IAM role on EC2.
AWS_REGION=""
AWS_S3_BUCKET=""
# Optional object namespace for deployments that share a bucket. Docker
# Compose pins production to "prod/" and development to "dev/".
S3_KEY_PREFIX=""
# Max upload size in bytes (default 52428800 = 50 MiB)
LEARNING_MATERIAL_MAX_BYTES="52428800"
# Optional: MinIO or LocalStack (path-style addressing is enabled when set)
AWS_S3_ENDPOINT=""
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY if not using IAM role

# Database backup (WebDAV) is configured in the admin dashboard (Database
# Backup); the WebDAV credentials are stored encrypted in the database.

# Admin > System Resources. Every node records its own CPU/RAM/storage into its
# own database, so prod and dev can only chart all four nodes if each site can
# fetch the other's. Set the SAME token on both deployments and point each at
# the other's PUBLIC url (the proxy validates the Host header). Leave the token
# empty to keep each site showing only its own web node and worker.
RESOURCE_MONITOR_TOKEN=""
RESOURCE_MONITOR_PEER_URL=""
# Optional tuning: sample cadence (default 60000ms, floor 10000) and how long
# samples are kept (default 7 days — the tab charts one week).
RESOURCE_SAMPLE_INTERVAL_MS=""
RESOURCE_SAMPLE_RETENTION_DAYS=""
