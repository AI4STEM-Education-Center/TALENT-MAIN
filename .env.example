# Database
# DATABASE_URL is used by Prisma directly (local dev).
# PROD_DATABASE_URL is mapped to DATABASE_URL by docker-compose for production.
# DEV_DATABASE_URL is mapped to DATABASE_URL by docker-compose for dev.
DATABASE_URL="file:./data/dev.db"
PROD_DATABASE_URL="file:./data/prod.db"
DEV_DATABASE_URL="file:./data/dev.db"
DB_PROVIDER="sqlite"

# Environment identity for database backups: "prod" | "dev" (defaults to "dev").
# docker-compose sets this per environment. Backups land in
# <WebDAV baseDir>/<APP_ENV>/.
APP_ENV="dev"

# Docker Compose maps the appropriate URL onto APP_URL and APP_BASE_URL for
# each stack. The worker has no incoming request from which to infer a host,
# so both values are required on a shared prod/dev box.
PROD_APP_URL="https://ai4talent.org"
DEV_APP_URL="https://dev.ai4talent.org"

# Local/non-Compose fallback. AUTH_URL / NEXTAUTH_URL are also used if set.
APP_URL=""

# Auth
AUTH_SECRET="generate-a-random-secret-here"

# Public origin used to build links the app emails out (password reset).
# Optional: when unset the origin is derived from the request's proxy headers,
# which is correct for normal browser traffic. Set it if links must always
# point at one canonical host.
APP_BASE_URL=""

# Teacher signup restriction — share only with intended teachers
TEACHER_SIGNUP_TOKEN="your-secret-teacher-code"

# Admin signup restriction — share only with intended admins
ADMIN_SIGNUP_TOKEN="your-secret-admin-code"

# AI Provider Encryption Key (required)
# Used to encrypt API keys stored in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_SECRET=""

# AWS credentials (REQUIRED). Supplied explicitly from this file — IAM instance
# roles are not used, so the app fails with a clear error rather than silently
# depending on whichever identity the host happens to provide.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional: only for temporary STS credentials.
AWS_SESSION_TOKEN=""

# Learning material and quiz PDF storage (S3).
AWS_REGION=""
AWS_S3_BUCKET=""
# Optional object namespace for deployments that share a bucket. Docker
# Compose pins production to "prod/" and development to "dev/".
S3_KEY_PREFIX=""
# Max upload size in bytes (default 52428800 = 50 MiB)
LEARNING_MATERIAL_MAX_BYTES="52428800"
# Optional: MinIO or LocalStack (path-style addressing is enabled when set)
AWS_S3_ENDPOINT=""

# CloudFront delivery for images and PDFs. Reads are served as CloudFront signed
# URLs from a private, OAC-only bucket; uploads still go straight to S3 as
# presigned PUTs. Leave all three EMPTY to serve reads from S3 instead (local
# dev, MinIO) — that is also the rollback switch. Setting only some of the three
# is rejected at startup of the first signing call.
# Setup: docs/SETUP.md
CLOUDFRONT_DOMAIN=""
CLOUDFRONT_KEY_PAIR_ID=""
# The private key of the distribution's trusted key group, base64-encoded so it
# fits on one line (a .env read by Docker Compose cannot contain newlines):
#   base64 -w0 private_key.pem
# A PEM with literal \n escapes is also accepted.
CLOUDFRONT_PRIVATE_KEY=""

# Comma-separated retired API_KEY_ENCRYPTION_SECRET values, kept so existing
# ciphertext still decrypts during a key rotation (see SECURITY.md).
API_KEY_ENCRYPTION_SECRET_OLD=""

# How long the worker retains system log rows, in days (default 90).
SYSTEM_LOG_RETENTION_DAYS="90"

# Database backup (WebDAV) is configured in the admin dashboard (Database
# Backup); the WebDAV credentials are stored encrypted in the database.

# Admin > System Resources. Every node writes its CPU/RAM/storage samples here,
# and reads every other node's from the same place. Both compose stacks set this
# to /app/metrics and attach the shared `talent-resource-metrics` volume, which
# is what lets each site chart all four nodes — prod and dev run on one EC2
# instance, so no cross-deployment request is involved. Leave it empty outside
# Docker: each deployment then keeps a private spool beside its data directory
# and charts only its own web node and worker.
RESOURCE_SPOOL_DIR=""
# Optional: where to read the HOST's counters from, for the whole-machine panel.
# Defaults to /proc, which inside a Docker container is already the host's.
HOST_PROC_DIR=""
# Optional tuning: sample cadence (default 60000ms, floor 10000) and how long
# samples are kept (default 7 days — the tab charts one week).
RESOURCE_SAMPLE_INTERVAL_MS=""
RESOURCE_SAMPLE_RETENTION_DAYS=""
